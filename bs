#!/usr/bin/env bash
#
#  BS Framework – STAGE-2 UNIFIED ENTRY-POINT / INTERPRETER
#  Назначение / Purpose:
#    - инициализировать окружение фреймворка;
#    - обрабатывать пользовательские команды (run, doctor, list …);
#    - работать как shebang-интерпретатор (#!/usr/bin/env bs).
#  Зависимости: bash 4.0+, bootstrap/init.sh, структура каталогов
#              core/, lib/ (опционально, но doctor ругается).
#

# 1. Каталог entry-point'а — нужен до загрузки чего-либо
BS_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)

# 2. Pre-kernel root namespace: shell version gate (bash 3.2-compatible)
#    Строгий режим включается именованной pre-kernel функцией bs::strict.
#    Strict mode is enabled via the named pre-kernel helper bs::strict.
if [[ -f "${BS_DIR}/bootstrap/bs.sh" ]]; then
  source "${BS_DIR}/bootstrap/bs.sh"
  bs::strict
  bs::shell::ensure_version 4 || exit 1
else
  printf 'ERROR: bootstrap/bs.sh not found in %s\n' "$BS_DIR" >&2
  exit 2
fi

# 3. Определение BS_ROOT (если ещё не задан)
if [[ -z "${BS_ROOT:-}" ]]; then
  # Если bs запущен из репо-корня, bootstrap/init.sh рядом
  if [[ -f "${BS_DIR}/bootstrap/init.sh" ]]; then
    BS_ROOT=$BS_DIR
  else
    # Ищем в стандартных местах
    for dir in "${HOME}/.local/lib/bs" "/usr/local/lib/bs"; do
      if [[ -f "${dir}/bootstrap/init.sh" ]]; then
        BS_ROOT=$dir
        break
      fi
    done
  fi
  export BS_ROOT
fi

# 4. BS_HOME и тишина по умолчанию / BS_HOME and quiet-by-default
# BS_HOME: историческое расхождение с BS_ROOT в lib-модулях;
# задаём единообразно, чтобы скриптам не приходилось экспортировать его руками
# BS_HOME: historical mismatch with BS_ROOT in lib modules;
# set it uniformly so scripts do not have to export it by hand
: "${BS_HOME:=${BS_ROOT}}"
export BS_HOME

# По умолчанию не шумим при загрузке ядра: вывод скрипта важнее
# Quiet by default when loading core: the script's own output matters more
: "${BS_SILENT:=1}"
export BS_SILENT

# 5. Загрузка ядра
if [[ ! -f "${BS_ROOT}/bootstrap/init.sh" ]]; then
  printf 'ERROR: bootstrap/init.sh not found in BS_ROOT=%s\n' "$BS_ROOT" >&2
  exit 2
fi
# CLI всегда загружает ядро заново, даже если окружение уже
# инициализировано (BS_INITIALIZED из sourced-сессии иначе пропустит загрузку)
unset BS_INITIALIZED
source "${BS_ROOT}/bootstrap/init.sh"

# EXIT-trap для стека cleanup (ядро при source trap больше не ставит)
# EXIT trap for the cleanup stack (core no longer sets it when sourced)
errorhandler::setup_trap

# 6. Утилитные функции
die()  { error::exit "$*"; }

help() {
  cat <<HELP
BS Framework $(bs::version::get) – command launcher & shebang interpreter
Usage: bs [command] [args...]

Commands:
  help, -h, --help    Show this help
  version             Print framework version
  env                 Show environment (BS_ROOT, PATH)
  list                List available modules (core/, lib/)
  lang-doc            Emit a JSON index of function docs (LSP metadata)
  lsp                 Run the language server (stdin/stdout, JSON-RPC)
  chat                Interactive LLM chat (openai/ollama, --url for custom)
  api                 OpenAPI 3.x client (load spec, list paths, call operations)
  ts                  TypeScript toolchain + local mini stack (thriller)
  doctor              Check framework integrity
  run <script> [args] Execute script inside BS environment
  build <script>      Assemble a standalone self-extracting script
  repl                Interactive REPL (BS shell / интерактивная консоль)
  calc                RPN calculator on dc (обратная польская нотация)
  update              Update installed copies from a local repo or GitHub
  uninstall           Remove installed BS copies (wrapper + lib tree)
  init-shell          Print snippet for ~/.bashrc or ~/.zshrc

Shebang mode:
  #!/usr/bin/env bs
  (set BS_SHEBANG=1 internally)

Examples:
  bs doctor
  bs run ./examples/deploy.sh --prod
  bs list | grep system
HELP
}

version() { bs::version::print; }
# @private Значение ключа из манифеста установки (<lib>/.install, key=value).
# @private Value of a key from the install manifest (<lib>/.install, key=value).
# @param $1 Install directory / Каталог установки
# @param $2 Key / Ключ
install_info_get() {
  local -r file="$1/.install" key="$2"
  local line
  [[ -f "${file}" ]] || return 0
  while IFS= read -r line; do
    if [[ "${line}" == "${key}="* ]]; then
      printf '%s\n' "${line#*=}"
      return 0
    fi
  done < "${file}"
  return 0
}

env_cmd() {
  printf 'BS_ROOT=%s\nPATH=%s\n' "$BS_ROOT" "$PATH"
  # Как установлена эта копия (манифест пишет install.sh)
  # How this copy was installed (the manifest is written by install.sh)
  if [[ -f "${BS_ROOT}/.install" ]]; then
    printf '\nInstall manifest (%s):\n' "${BS_ROOT}/.install"
    local line
    while IFS= read -r line; do
      [[ -z "${line}" || "${line}" == '#'* ]] || printf '  %s\n' "${line}"
    done < "${BS_ROOT}/.install"
  elif is::dir "${BS_ROOT}/tests"; then
    printf '\nInstall: source checkout (not installed) / исходный репозиторий\n'
  else
    printf '\nInstall: no manifest (installed by an older installer) / манифеста нет\n'
  fi
}

list_cmd() {
  echo 'Available modules:'
  local file
  local count=0
  while IFS= read -r file; do
    if is::file "${file}"; then
      printf '  %s\n' "${file#"${BS_ROOT}"/}"
      count=$(( count + 1 ))
    fi
  done < <(find "${BS_ROOT}/core" "${BS_ROOT}/lib" -type f -name '*.sh' 2>/dev/null | sort)
  printf '%d modules\n' "${count}"
}

lang_doc_cmd() {
  local file=""
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --file)
        shift
        [[ $# -ge 1 ]] || die "lang-doc: --file requires a path"
        file="$1"
        shift ;;
      -h|--help)
        printf 'Usage: bs lang-doc [--file path]\n\n'
        printf 'Emits a JSON array of {name, file, description, params, returns,\n'
        printf 'stdout, example, deprecated} for every documented function in\n'
        printf 'core/ and lib/. With --file, only that file is parsed.\n'
        printf 'Requires jq (optional dev dependency).\n'
        return 0 ;;
      *)
        die "lang-doc: unknown argument: $1" ;;
    esac
  done

  load "lib/data/langdoc"
  is::command jq || die "lang-doc: jq is required (optional dev tool)"

  if is::not_empty "${file}"; then
    is::file "${file}" || die "lang-doc: file not found: ${file}"
    langdoc::parse_file "${file}" | jq -s -c .
  else
    langdoc::index "${BS_ROOT}"
  fi
}

lsp_cmd() {
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      -h|--help)
        printf 'Usage: bs lsp\n\n'
        printf 'Runs a minimal Language Server (JSON-RPC 2.0 over stdin/stdout,\n'
        printf 'Content-Length framing): initialize, hover, completion,\n'
        printf 'full text sync. The function index over BS_ROOT is built lazily.\n'
        printf 'Requires jq. Wire it up in VS Code / Neovim as a custom server.\n'
        return 0 ;;
      *)
        die "lsp: unknown argument: $1" ;;
    esac
  done

  load "lib/data/langdoc"
  load "lib/data/lsp"
  is::command jq || die "lsp: jq is required (optional dev tool)"
  lsp::server
}

chat_cmd() {
  local provider="${BS_CHAT_PROVIDER:-}"
  local model="${BS_CHAT_MODEL:-}"
  local system_prompt="${BS_CHAT_SYSTEM:-You are a helpful assistant for the BS framework.}"
  local one_shot="" limit=20 show_raw=0 url="" api_key=""
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --provider)
        shift
        [[ $# -ge 1 ]] || die "chat: --provider requires a name"
        provider="$1"
        shift ;;
      --model|-m)
        shift
        [[ $# -ge 1 ]] || die "chat: --model requires a name"
        model="$1"
        shift ;;
      --system|-s)
        shift
        [[ $# -ge 1 ]] || die "chat: --system requires a prompt"
        system_prompt="$1"
        shift ;;
      --one-shot)
        shift
        [[ $# -ge 1 ]] || die "chat: --one-shot requires a message"
        one_shot="$1"
        shift ;;
      --history)
        shift
        [[ $# -ge 1 ]] || die "chat: --history requires a number"
        limit="$1"
        shift ;;
      --url)
        shift
        [[ $# -ge 1 ]] || die "chat: --url requires an endpoint (e.g. http://pi.local:8080/v1/chat/completions)"
        url="$1"
        shift ;;
      --api-key)
        shift
        [[ $# -ge 1 ]] || die "chat: --api-key requires a key"
        api_key="$1"
        shift ;;
      --show-raw)
        show_raw=1
        shift ;;
      -h|--help)
        printf 'Usage: bs chat [--provider p] [--model m] [--system text]\n'
        printf '          [--one-shot msg] [--history N] [--url URL] [--api-key KEY]\n\n'
        printf 'Interactive multi-turn chat with an LLM.\n'
        printf 'Providers: openai (API key required) or ollama (local).\n'
        printf 'A custom local model (e.g. Phi Pi) plugs in as an OpenAI-compatible\n'
        printf 'endpoint: bs chat --url http://host:port/v1/chat/completions --model phi-pi\n'
        printf 'Env defaults: BS_CHAT_PROVIDER, BS_CHAT_MODEL, BS_CHAT_SYSTEM.\n'
        printf 'Requires curl and jq.\n'
        return 0 ;;
      *)
        if is::empty "${one_shot}"; then
          one_shot="$1"
        else
          die "chat: unexpected argument: $1"
        fi
        shift ;;
    esac
  done

  load "lib/integration/llm"
  load "lib/integration/chat"
  is::command curl || die "chat: curl is required"
  is::command jq || die "chat: jq is required"

  # Дефолтный провайдер: ollama, если доступен, иначе openai
  # Default provider: ollama when reachable, otherwise openai
  if is::empty "${provider}"; then
    if llm::is_available ollama; then
      provider="ollama"
    else
      provider="openai"
    fi
  fi
  if is::empty "${model}"; then
    if [[ "${provider}" == "ollama" ]]; then
      model="${LLM_OLLAMA_MODEL:-llama3}"
    else
      model="${LLM_OPENAI_MODEL:-gpt-3.5-turbo}"
    fi
  fi

  # Переопределение эндпоинта / Endpoint override
  if is::not_empty "${url}"; then
    if [[ "${provider}" == "ollama" ]]; then
      export LLM_OLLAMA_HOST="${url}"
    else
      export LLM_OPENAI_URL="${url}"
    fi
  fi
  if is::not_empty "${api_key}"; then
    export OPENAI_API_KEY="${api_key}"
  fi

  chat::repl "${provider}" "${model}" "${system_prompt}" "${one_shot}" "${limit}" "${show_raw}"
}

doctor_cmd() {
  local fail=0
  local pass=0
  local start_ms
  start_ms=$(utils::now_ms)

  # Вектор возможностей / Capability vector
  if [[ "${1:-}" == "--capabilities" ]]; then
    load "lib/platform/facts"
    platform::dump
    return 0
  fi
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    printf 'Usage: bs doctor [--capabilities]\n'
    printf '  --capabilities  print the platform capability vector\n'
    return 0
  fi

  log::info "BS doctor report"
  log::info "BS_ROOT: ${BS_ROOT}"

  # Единая таблица статусов: STATUS | ITEM | DETAIL
  # One aligned status table: STATUS | ITEM | DETAIL
  log::info "$(printf '  %-8s | %-30s | %s' "STATUS" "ITEM" "DETAIL")"
  log::info "$(printf '  %-8s | %-30s | %s' "--------" "------------------------------" "--------")"

  # Bash version gate already ran in the pre-kernel namespace
  # (bootstrap/bs.sh::bs::shell::ensure_version) — no re-check here.
  # Гейт версии bash уже отработал в pre-kernel namespace
  # (bootstrap/bs.sh::bs::shell::ensure_version) — повторная проверка не нужна.

  # Required core files / Обязательные файлы ядра
  local req=(bootstrap/init.sh bootstrap/loader.sh bootstrap/bs.sh core/prereq.sh core/lang.sh core/const.sh core/logger.sh core/errorhandler.sh core/version.sh core/utils.sh core/config.sh core/deps.sh core/repl.sh core/calc.sh)
  local f
  for f in "${req[@]}"; do
    if is::file "${BS_ROOT}/${f}"; then
      log::success "$(printf '  %-8s | %-30s | %s' "OK" "${f}" "required core file")"
      pass=$(( pass + 1 ))
    else
      log::error "$(printf '  %-8s | %-30s | %s' "FAIL" "${f}" "required core file missing")"
      fail=1
    fi
  done

  # Required directories / Обязательные директории
  local d
  for d in core lib; do
    if is::dir "${BS_ROOT}/${d}"; then
      log::success "$(printf '  %-8s | %-30s | %s' "OK" "dir ${d}" "required directory")"
      pass=$(( pass + 1 ))
    else
      log::error "$(printf '  %-8s | %-30s | %s' "FAIL" "dir ${d}" "required directory missing")"
      fail=1
    fi
  done

  # Optional external tools / Опциональные внешние инструменты
  local opt
  for opt in shellcheck jq curl wget kubectl; do
    if is::command "${opt}"; then
      log::success "$(printf '  %-8s | %-30s | %s' "OK" "tool ${opt}" "found")"
      pass=$(( pass + 1 ))
    else
      log::warn "$(printf '  %-8s | %-30s | %s' "OPTIONAL" "tool ${opt}" "not found")"
    fi
  done

  # Optional dependency check for lib modules / Проверка опциональных зависимостей lib-модулей
  if is::function deps::check_module; then
    local module
    for module in lib/integration/result lib/integration/http lib/integration/llm lib/integration/k8s; do
      if is::file "${BS_ROOT}/${module}.sh"; then
        if utils::quiet deps::check_module "${module}"; then
          log::success "$(printf '  %-8s | %-30s | %s' "OK" "module ${module}" "dependencies satisfied")"
          pass=$(( pass + 1 ))
        else
          local missing
          missing="$(utils::attempt deps::list_missing "${module}")"
          log::warn "$(printf '  %-8s | %-30s | %s' "OPTIONAL" "module ${module}" "missing dependencies: ${missing}")"
        fi
      fi
    done
  fi

  local end_ms
  end_ms=$(utils::now_ms)
  log::info "doctor: ${pass} passed, ${fail} failed ($(( end_ms - start_ms )) ms)"

  return "$fail"
}

run_cmd() {
  [[ $# -eq 0 ]] && die "run: script path required"
  local script=$1; shift
  is::file "$script" || die "run: file not found: $script"
  # Запускаем скрипт в новом bash с уже загруженным BS-окружением
  # Сбрасываем унаследованный BS_INITIALIZED, иначе init.sh пропустит загрузку
  exec bash -c '
    unset BS_INITIALIZED
    source "'"${BS_ROOT}/bootstrap/init.sh"'"
    bs::strict
    script=$1; shift
    source "$script" "$@"
  ' bash "$script" "$@"
}

# ==========================================
# bs build: standalone self-extracting script / сборка в один файл
# ==========================================

# Build helper: base64 with -w0 fallback for busybox / base64 с fallback на busybox
bs_build::b64() {
  if printf '' | base64 -w0 >/dev/null 2>&1; then
    base64 -w0
  else
    base64 | tr -d '\n'
  fi
}

# Build helper: robust sha256 (coreutils, busybox-less systems, macOS) / sha256 с fallback
bs_build::sha256() {
  if utils::has sha256sum; then
    sha256sum | awk '{print $1}'
  elif utils::has shasum; then
    shasum -a 256 | awk '{print $1}'
  else
    cksum | awk '{print $1}'
  fi
}

# Runtime preamble of the generated standalone file.
# Не зависит от фреймворка: распаковывает себя в кэш и запускает bs.
# Framework-independent: extracts itself into a cache dir and execs bs.
bs_build::preamble() {
  cat <<'PREAMBLE'
#!/usr/bin/env bash
# BS standalone application — generated by `bs build` / собрано командой `bs build`.
# Self-extracting: unpacks the bundled framework into a cache dir, then execs bs.
set -euo pipefail

bs_seek::b64() {
  if printf '' | base64 -w0 >/dev/null 2>&1; then
    base64 -w0
  else
    base64 | tr -d '\n'
  fi
}

bs_seek::sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | awk '{print $1}'
  else
    cksum | awk '{print $1}'
  fi
}

bs_seek::main() {
local line payload
  line="$(grep -n '^#__BS_BUILD_PAYLOAD__' "$0" | head -n 1 | cut -d: -f1 || true)"
  [[ -n "${line}" ]] || { echo "bs: payload marker not found in $0" >&2; exit 1; }
  payload="$(sed -n "$((line + 1)),\$p" "$0")"
  [[ -n "${payload}" ]] || { echo "bs: empty payload in $0" >&2; exit 1; }

  local hash cache_root root tmp
  hash="$(printf '%s' "${payload}" | bs_seek::sha256)"
  cache_root="${BS_BUILD_CACHE_DIR:-${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/bs}"
  root="${cache_root}/${hash}"

  if [[ ! -x "${root}/bs" ]]; then
    mkdir -p "${cache_root}"
    tmp="$(mktemp -d "${cache_root}/extract.XXXXXX")"
    printf '%s' "${payload}" | base64 -d | tar -xz -C "${tmp}"
    mv "${tmp}" "${root}" 2>/dev/null || rm -rf "${tmp}"
  fi

  export BS_ROOT="${root}"
  export BS_HOME="${root}"
  export BS_SILENT=1
  export BS_CACHE_DIR="${root}"
  exec "${root}/bs" run "${root}/app/main.sh" "$@"
}

bs_seek::main "$@"
PREAMBLE
}

# Assemble a standalone self-extracting script / Собрать standalone-скрипт
# @usage bs build <script.sh> [--output file]
build_cmd() {
  local script="" out_file=""
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      -h|--help)
        printf 'Usage: bs build <script.sh> [--output file]\n\n'
        printf 'Assembles a standalone self-extracting script: framework and\n'
        printf 'the app are bundled (gzip+base64) and extracted to a cache dir\n'
        printf 'at first run. Cache: $XDG_CACHE_HOME/bs or BS_BUILD_CACHE_DIR.\n'
        return 0 ;;
      --output)
        shift
        [[ $# -ge 1 ]] || die "build: --output requires a path"
        out_file="$1"; shift ;;
      *)
        if is::empty "${script}"; then
          script="$1"
        else
          die "build: unexpected extra argument: $1"
        fi
        shift ;;
    esac
  done

  is::not_empty "${script}" || die "build: script path required"
  is::file "$script" || die "build: file not found: $script"
  if ! utils::quiet_err bash -n "$script"; then
    die "build: bash syntax errors in: $script"
  fi

  [[ -n "$out_file" ]] || out_file="${script%.sh}.standalone.sh"

  local tmp_dir app_dir
  tmp_dir="$(mktemp -d)"
  trap 'rm -rf "${tmp_dir}"' RETURN

  # Спрятать app под app/main.sh внутри payload
  # The app is bundled as app/main.sh inside the payload
  app_dir="${tmp_dir}/app"
  mkdir -p "${app_dir}"
  utils::quiet cp -- "$script" "${app_dir}/main.sh" || die "build: cannot read script: $script"

  # Бандл: рантайм-дерево (bootstrap core lib bs) + app/ одним tar-потоком.
  # Конкатенация двух tar-архивов читается далеко не всеми tar'ами,
  # поэтому используем один вызов с двумя -C.
  # Bundle: runtime tree (bootstrap core lib bs) + app/ in one tar stream.
  # Two concatenated tar archives are not readable by every tar,
  # so use a single invocation with two -C.
  # base64 до bash-переменной: gzip содержит NUL-байты, которые
  # command substitution молча вырезает.
  # Base64 before the bash variable: gzip contains NULs which
  # command substitution silently strips.
  local payload hash
  payload="$(
    tar -C "${BS_ROOT}" -c -f - bootstrap core lib bs \
        -C "${tmp_dir}" app \
    | gzip | bs_build::b64
  )"
  hash="$(printf '%s' "${payload}" | bs_build::sha256)"

  # Output written under a temp name, then moved — атомарность и права
  local out_tmp
  out_tmp="${out_file}.bs-build.$$"
  bs_build::preamble > "${out_tmp}"
  printf '%s\n' "#__BS_BUILD_PAYLOAD__" >> "${out_tmp}"
  printf '%s\n' "${payload}" >> "${out_tmp}"
  chmod 0755 "${out_tmp}"
  mv -f -- "${out_tmp}" "${out_file}"
  rm -rf "${tmp_dir}"

  printf 'Built: %s\n' "${out_file}"
  printf 'Framework bundle: %s bytes (payload hash %s)\n' "$(( ${#payload} ))" "${hash}"
}

rfc_cmd() {
  local -r rfc_dir="${BS_ROOT}/lib/rfc"
  case "${1:-}" in
    -h|--help)
      printf 'Usage: bs rfc [number]\n\n'
      printf 'Lists implemented RFC modules; with a number, shows or runs\n'
      printf 'that RFC (e.g. bs rfc 1925 — the twelve networking truths).\n'
      return 0 ;;
    ""|list)
      local file name
      for file in "${rfc_dir}"/*.sh; do
        name="$(basename "${file}" .sh)"
        printf '  %-12s %s\n' "${name}" "$(grep -m1 -o 'RFC [0-9]*:.*' "${file}" | sed 's/^RFC [0-9]*: //')"
      done
      return 0 ;;
    1925)
      load "lib/rfc/rfc1925"
      rfc1925::truths
      ;;
    3986)
      load "lib/rfc/uri"
      printf 'RFC 3986 — URI. Functions: uri::parse, uri::dump, uri::decode, uri::encode.\n'
      printf 'Example:\n  uri::parse "https://user:pw@host:8080/p?a=1#f"\n  echo "${URI_HOST}:${URI_PORT}"\n'
      ;;
    4122)
      load "lib/rfc/uuid"
      printf 'RFC 4122/9562 — UUID. Functions: uuid::gen, uuid::gen_v7, uuid::validate.\n'
      printf 'Example:\n  uuid::gen\n'
      ;;
    4180)
      load "lib/rfc/csv"
      printf 'RFC 4180 — CSV. Functions: csv::rows, csv::fields.\n'
      printf 'Example:\n  csv::fields "a,\"b,c\"" f && printf "%%s\\n" "${f[1]}"\n'
      ;;
    *)
      die "rfc: unknown RFC: $1 (implemented: 1925, 3986, 4122, 4180)"
      ;;
  esac
}

# ==========================================
# bs api: OpenAPI 3.x client (spec load, introspect, call)
# bs api: OpenAPI 3.x клиент (загрузка схемы, интроспекция, вызовы)
# ==========================================

api_cmd() {
  local sub="${1:-}"
  shift || true

  load "lib/api/openapi"

  case "${sub}" in
    load)
      local name="${1-}" source="${2-}"
      if [[ $# -lt 2 ]] || is::empty "${name}" || is::empty "${source}"; then
        die "api load: requires NAME and FILE-or-URL (e.g. bs api load petstore ./openapi.json)"
      fi
      api::spec::load "${name}" "${source}" || die "api load: failed"
      ;;
    list)
      api::spec::list
      ;;
    info)
      [[ $# -ge 1 ]] || die "api info: requires spec NAME"
      api::spec::info "$1"
      ;;
    paths)
      [[ $# -ge 1 ]] || die "api paths: requires spec NAME (use --method GET to filter)"
      api::paths "$@"
      ;;
    call)
      [[ $# -ge 3 ]] || die "api call: requires NAME METHOD PATH (e.g. bs api call petstore GET /pets --json)"
      api::call "$@" || die "api call: failed"
      ;;
    drop)
      [[ $# -ge 1 ]] || die "api drop: requires spec NAME"
      api::spec::drop "$1"
      ;;
    -h|--help|"")
      printf 'Usage: bs api <subcommand> [args]\n\n'
      printf 'OpenAPI 3.x client / OpenAPI 3.x клиент\n'
      printf '  load NAME FILE|URL   load a spec (URL is cached) / загрузить схему\n'
      printf '  list                 loaded specs / загруженные схемы\n'
      printf '  info NAME            title, version, server / заголовок, версия, сервер\n'
      printf '  paths NAME [--method M]  list operations / список операций\n'
      printf '  call NAME METHOD PATH [--name VALUE ...] [--token T] [--body B] [--json]\n'
      printf '  drop NAME            unload a spec / выгрузить схему\n\n'
      printf 'Examples / Примеры:\n'
      printf '  bs api load petstore https://petstore3.swagger.io/api/v3/openapi.json\n'
      printf '  bs api call petstore GET /pet/{petId} --petId 1 --json\n'
      return 0 ;;
    *)
      die "api: unknown subcommand: ${sub} (see: bs api --help)"
      ;;
  esac
}

# ==========================================
# bs audit: GNU-only tool usage in core/ and lib/
# bs audit: использование GNU-only инструментов в core/ и lib/
# ==========================================

audit_cmd() {
  local -r audit_gnu_tools='grep[[:space:]]+-P|sed[[:space:]]+-z|sha256sum|stat[[:space:]]+-c|date[[:space:]]+\+%N|readlink[[:space:]]+-f|head[[:space:]]+-c'
  local audit_roots_str="${1:-core lib}"
  # IFS в CLI = $'\n\t' (без пробела) — префикс IFS=' ' только для read
  local -a audit_roots=()
  IFS=' ' read -ra audit_roots <<< "${audit_roots_str}"
  local file n bad=0
  for file in $(find "${audit_roots[@]}" -name '*.sh' 2>/dev/null | sort); do
    n="$(grep -cE "${audit_gnu_tools}" "${file}" 2>/dev/null || true)"
    if (( n > 0 )); then
      local tier
      tier="$(grep -m1 '^# @tier' "${file}" | awk '{print $3}' || true)"
      printf '  %-40s GNU-only: %-3d tier: %s\n' "${file}" "${n}" "${tier:-unspecified}"
      bad=1
    fi
  done
  if (( bad == 0 )); then
    printf 'No GNU-only tool usage found in %s\n' "${audit_roots_str}"
  fi
  return 0
}

init_shell_cmd() {
  cat <<EOF
# Add to ~/.bashrc or ~/.zshrc
export BS_ROOT="${BS_ROOT}"
source "\${BS_ROOT}/bootstrap/init.sh"
EOF
}

# ==========================================
# bs update: apply repo changes (local checkout or GitHub) to installed copies
# bs update: применить изменения репозитория (локального или с GitHub) к установленным копиям
# ==========================================

# @private Boxed notice printed WITHOUT log prefixes — timestamps would
# break the frame (log::header suffers from this in timestamped output).
# Рамка-уведомление БЕЗ лог-префиксов — таймстампы ломают рамку
# (log::header страдает этим при включённых таймстампах).
# @param $1 Title / Заголовок
# @param $@ Body lines, hard-wrapped at inner width / Строки тела с переносом
update_box() {
  local -r title="$1"
  shift
  local -r inner=58
  local -a body=()
  local text
  for text in "$@"; do
    while (( ${#text} > inner )); do
      body+=("${text:0:inner}")
      text="${text:inner}"
    done
    body+=("${text}")
  done

  local color_b='' color_reset=''
  if log::__is_color_enabled 1; then
    color_b=$'\033[34m'
    color_reset=$'\033[0m'
  fi
  local rule
  printf -v rule '%*s' "${inner}" ''
  rule="${rule// /─}"
  local title_row
  printf -v title_row '%*s' "$(( (inner - ${#title}) / 2 ))" ''
  title_row+="${title}"

  # Паддинг вручную по символам: bash printf '%-*s' считает ширину в БАЙТАХ,
  # с кириллицей рамка разъезжается. ${#x} считает символы (= клетки для
  # кириллицы и глифов рамки).
  # Pad by CHARACTERS: bash printf '%-*s' measures width in BYTES, which
  # breaks the frame with Cyrillic. ${#x} counts chars (= cells here).
  local n
  (( n = inner - ${#title_row} )) && (( n > 0 )) && printf -v title_row '%s%*s' "${title_row}" "${n}" ''
  printf '%s╭%s╮%s\n' "${color_b}" "${rule}" "${color_reset}"
  printf '%s│%s│%s\n' "${color_b}" "${title_row}" "${color_reset}"
  printf '%s├%s┤%s\n' "${color_b}" "${rule}" "${color_reset}"
  local line
  for line in "${body[@]}"; do
    (( n = inner - ${#line} )) && (( n > 0 )) && printf -v line '%s%*s' "${line}" "${n}" ''
    printf '%s│%s│%s\n' "${color_b}" "${line}" "${color_reset}"
  done
  printf '%s╰%s╯%s\n' "${color_b}" "${rule}" "${color_reset}"
}

# URL репозитория по умолчанию для `bs update --github` (переопределяется
# флагом --repo или переменной BS_UPDATE_REPO).
# Default repository URL for `bs update --github` (override with --repo or
# the BS_UPDATE_REPO variable).
readonly UPDATE_DEFAULT_REPO="https://github.com/Igormm/bs"

# @private Каталог со скачанным источником; удаляется стеком cleanup.
# @private Directory with the downloaded source; removed by the cleanup stack.
UPDATE_FETCH_DIR=""
update_fetch_cleanup() {
  [[ -n "${UPDATE_FETCH_DIR}" ]] && rm -rf -- "${UPDATE_FETCH_DIR}"
  return 0
}

# @private Скачать репозиторий во временный каталог: git clone (shallow),
# иначе tar-архив через curl/wget. Путь кладётся в UPDATE_FETCH_DIR.
# @private Download the repository into a temp dir: shallow git clone, else
# a tarball via curl/wget. The path is stored in UPDATE_FETCH_DIR.
# @param $1 Repo URL / URL репозитория
# @param $2 Branch or tag / Ветка или тег
update_fetch() {
  local -r repo="${1%.git}"
  local -r ref="$2"
  UPDATE_FETCH_DIR="$(mktemp -d)"
  cleanup::add update_fetch_cleanup
  local -r dest="${UPDATE_FETCH_DIR}/src"

  if utils::has git \
     && utils::quiet git clone --quiet --depth 1 --branch "${ref}" -- "${repo}" "${dest}"; then
    return 0
  fi
  rm -rf -- "${dest}"
  mkdir -p -- "${dest}"

  local -r archive="${repo}/archive/${ref}.tar.gz"
  if utils::has curl; then
    curl -fsSL -- "${archive}" 2>/dev/null | utils::quiet tar -xz -C "${dest}" --strip-components=1 \
      && return 0
  elif utils::has wget; then
    wget -qO- -- "${archive}" 2>/dev/null | utils::quiet tar -xz -C "${dest}" --strip-components=1 \
      && return 0
  fi
  die "update: cannot download ${repo} (${ref}) — need git or curl/wget and network access"
}

# @private Сравнить локальный checkout с удалённой веткой, ничего не меняя
# в репозитории (ls-remote, без fetch). Печатает одно слово:
#   same     — HEAD совпадает с удалённой веткой
#   ahead    — локально есть коммиты, которых нет на удалённой стороне
#   behind   — на удалённой стороне есть код, которого нет локально
#              (в т.ч. разошедшиеся истории)
#   unknown  — не git-checkout, нет сети или нет такой ветки
# @private Compare a local checkout with the remote branch without touching
# the repository (ls-remote, no fetch). Prints one word: same | ahead |
# behind (remote has code the checkout lacks, diverged included) | unknown.
# @param $1 Local checkout / Локальный checkout
# @param $2 Repo URL / URL репозитория
# @param $3 Branch / Ветка
update_local_state() {
  local -r dir="$1" repo="${2%.git}" ref="$3"
  if ! utils::has git || ! [[ -e "${dir}/.git" ]]; then
    printf 'unknown\n'
    return 0
  fi
  local -a limit=()
  utils::has timeout && limit=(timeout 15)
  local remote_sha head_sha
  remote_sha="$(GIT_TERMINAL_PROMPT=0 "${limit[@]}" git ls-remote -- "${repo}" "refs/heads/${ref}" 2>/dev/null | cut -f1)" || remote_sha=""
  head_sha="$(git -C "${dir}" rev-parse HEAD 2>/dev/null)" || head_sha=""
  if [[ -z "${remote_sha}" || -z "${head_sha}" ]]; then
    printf 'unknown\n'
  elif [[ "${remote_sha}" == "${head_sha}" ]]; then
    printf 'same\n'
  elif utils::quiet git -C "${dir}" merge-base --is-ancestor "${remote_sha}" HEAD; then
    printf 'ahead\n'
  else
    printf 'behind\n'
  fi
}

# @private Каталог установки из обёртки `bs` (install.sh пишет в неё
# export BS_ROOT="..."). Пустой вывод, если файл — не обёртка.
# @private Install directory named by a `bs` wrapper (install.sh writes
# export BS_ROOT="..." into it). Empty output if the file is not a wrapper.
# @param $1 Path to a `bs` executable / Путь к исполняемому `bs`
update_wrapper_root() {
  local -r file="$1"
  local -r re='^export BS_ROOT="([^"$]+)"$'
  local line n=0
  while IFS= read -r line && (( n++ < 5 )); do
    if [[ "${line}" =~ ${re} ]]; then
      printf '%s\n' "${BASH_REMATCH[1]}"
      return 0
    fi
  done < "${file}" 2>/dev/null
  return 0
}

# @private Обновить манифест установки после update: дата, источник, коммит.
# Для установки без манифеста (старый установщик) он создаётся: режим и
# обёртка выводятся из пути.
# @private Refresh the install manifest after an update: date, source,
# commit. An install without a manifest (older installer) gets one: mode and
# wrapper are derived from the path.
# @param $1 Install directory / Каталог установки
# @param $2 Source directory / Каталог-источник
# @param $3 Source label (path or URL@ref) / Метка источника
# @param $@ Optional command prefix (sudo) / Необязательный префикс (sudo)
update_manifest() {
  local -r target="$1" from="$2" label="$3"
  shift 3
  local -r file="${target}/.install"
  local content="" line commit=""
  if [[ -f "${file}" ]]; then
    while IFS= read -r line; do
      case "${line}" in
        version=*|updated_at=*|updated_from=*|updated_commit=*) ;;
        *) content+="${line}"$'\n' ;;
      esac
    done < "${file}"
  else
    local mode="custom"
    [[ "${target}" == "${HOME}/.local/lib/bs" ]] && mode="local"
    [[ "${target}" == "/usr/local/lib/bs" ]] && mode="system"
    content+="# BS install manifest — written by install.sh, updated by bs update"$'\n'
    content+="mode=${mode}"$'\n'
    content+="prefix=${target%/lib/bs}"$'\n'
    content+="lib=${target}"$'\n'
    content+="bin=${target%/lib/bs}/bin/bs"$'\n'
  fi
  if utils::has git && [[ -e "${from}/.git" ]]; then
    commit="$(git -C "${from}" rev-parse HEAD 2>/dev/null)" || commit=""
  fi
  # Версия ИСТОЧНИКА, а не запущенного bs: спрашиваем у самого источника
  # (его bs version → bs::version::get); если он не отвечает версией —
  # берём версию текущего bs.
  # The version of the SOURCE, not of the running bs: ask the source itself
  # (its bs version → bs::version::get); if it does not answer with a
  # version, fall back to the running bs.
  local version=""
  local -r re_version='([0-9]+(\.[0-9]+)+)$'
  version="$(env -u BS_VERSION -u BS_INITIALIZED BS_ROOT="${from}" BS_HOME="${from}" bash "${from}/bs" version 2>/dev/null)" || version=""
  if [[ "${version}" =~ ${re_version} ]]; then
    version="${BASH_REMATCH[1]}"
  else
    version="$(bs::version::get)"
  fi
  content+="version=${version}"$'\n'
  content+="updated_at=$(date '+%Y-%m-%d %H:%M:%S')"$'\n'
  content+="updated_from=${label}"$'\n'
  content+="updated_commit=${commit}"$'\n'
  printf '%s' "${content}" | "$@" tee -- "${file}" >/dev/null \
    || log::warn "update: cannot write the install manifest: ${file}"
}

update_cmd() {
  local from="${BS_ROOT}"
  local from_explicit=0
  local github=0
  local repo="${BS_UPDATE_REPO:-${UPDATE_DEFAULT_REPO}}"
  local ref="main"
  local -a targets=()
  local explicit=0
  local verbose=0

  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --local)
        explicit=1
        targets+=("${HOME}/.local/lib/bs")
        shift ;;
      --system)
        explicit=1
        targets+=("/usr/local/lib/bs")
        shift ;;
      --lib)
        shift
        [[ $# -ge 1 ]] || die "update: --lib requires a target directory"
        explicit=1
        targets+=("$1")
        shift ;;
      --from)
        shift
        [[ $# -ge 1 ]] || die "update: --from requires a source directory"
        from="$1"
        from_explicit=1
        shift ;;
      --github)
        github=1
        shift ;;
      --repo)
        shift
        [[ $# -ge 1 ]] || die "update: --repo requires a repository URL"
        github=1
        repo="$1"
        shift ;;
      --ref)
        shift
        [[ $# -ge 1 ]] || die "update: --ref requires a branch or tag"
        github=1
        ref="$1"
        shift ;;
      -v|--verbose)
        verbose=1
        shift ;;
      -h|--help)
        printf 'Usage: bs update [--local] [--system] [--lib DIR]\n'
        printf '                 [--from DIR | --github [--repo URL] [--ref REF]] [-v]\n\n'
        printf 'Applies framework changes to installed copies without reinstalling.\n'
        printf 'Targets:\n'
        printf '  --local   update to ~/.local/lib/bs      (local install)\n'
        printf '  --system  update to /usr/local/lib/bs    (system install, needs root)\n'
        printf '  --lib DIR update to a custom install directory\n'
        printf 'Source:\n'
        printf '  --from DIR  local repo checkout\n'
        printf '  --github    download from GitHub (%s)\n' "${UPDATE_DEFAULT_REPO}"
        printf '  --repo URL  another repository (or BS_UPDATE_REPO); implies --github\n'
        printf '  --ref REF   branch or tag (default: main); implies --github\n'
        printf 'Default source: the repo in CWD (./bs update); when bs runs from an\n'
        printf 'installed copy with no repo around — GitHub.\n'
        printf 'A local git checkout is compared with GitHub first: if it lacks new\n'
        printf 'code, bs asks which source to use (non-interactive: warns, uses local).\n'
        printf 'Without target flags: update every detected install — ~/.local/lib/bs,\n'
        printf '/usr/local/lib/bs, the copy bs runs from, the one behind `bs` in PATH.\n'
        printf 'Copies bootstrap/, core/, lib/, bs. A root-owned install is updated\n'
        printf 'through sudo when run in a terminal (otherwise: sudo bs update).\n'
        return 0 ;;
      *)
        die "update: unknown argument: $1" ;;
    esac
  done

  # Источник: если CWD — каталог репозитория, используем его.
  # Source: if CWD is the repo directory, use it as the source.
  if (( github == 1 && from_explicit == 1 )); then
    die "update: --from and --github are mutually exclusive"
  fi
  # Локальный checkout рядом (для сверки с GitHub): CWD-репозиторий, иначе
  # BS_ROOT, если это репозиторий, а не установленная копия (в ней нет tests/).
  # Local checkout around (to compare with GitHub): the CWD repo, else BS_ROOT
  # when it is a repo and not an installed copy (which has no tests/).
  local checkout=""
  if (( from_explicit == 1 )); then
    checkout="${from}"
  elif [[ -f "${PWD}/bs" && -d "${PWD}/core" && -d "${PWD}/tests" ]]; then
    checkout="${PWD}"
  elif is::dir "${from}/tests"; then
    checkout="${from}"
  fi

  if (( github == 0 && from_explicit == 0 )); then
    if [[ -n "${checkout}" ]]; then
      from="${checkout}"
    else
      # Развилка: bs запущен из установленной копии и репозитория рядом
      # нет — локального источника нет, берём с GitHub.
      # Fork: bs runs from an installed copy and there is no repo around —
      # no local source, so fetch from GitHub.
      github=1
    fi
  fi

  # Конфликт источников: локальный checkout и GitHub могут расходиться.
  # Source conflict: the local checkout and GitHub may differ.
  local state="unknown"
  [[ -n "${checkout}" ]] && state="$(update_local_state "${checkout}" "${repo}" "${ref}")"
  if (( github == 0 )) && [[ "${state}" == "behind" ]]; then
    log::warn "update: local repo is behind ${repo%.git}@${ref} — it lacks new code / локальный репозиторий отстаёт от GitHub"
    log::warn "update:   ${checkout}"
    if (( from_explicit == 0 )) && [[ -t 0 && -t 1 ]]; then
      local answer=""
      printf 'Источник / Source: [g]ithub (новее/newer), [l]ocal, [a]bort? [g] '
      read -r answer || answer="a"
      case "${answer,,}" in
        ''|g|github) github=1 ;;
        l|local)     : ;;
        *)           die "update: aborted / отменено" ;;
      esac
    else
      log::warn "update: installing the LOCAL code; for the newest run: git pull, or bs update --github"
    fi
  elif (( github == 1 )) && [[ -n "${checkout}" ]]; then
    if [[ "${state}" == "ahead" ]]; then
      log::warn "update: local repo has commits not pushed to ${repo%.git}@${ref} — GitHub lacks them / на GitHub нет локальных коммитов: ${checkout}"
    fi
    if utils::has git && [[ -e "${checkout}/.git" ]] \
       && [[ -n "$(git -C "${checkout}" status --porcelain -- bs bootstrap core lib 2>/dev/null)" ]]; then
      log::warn "update: local repo has uncommitted changes — they are NOT installed from GitHub / незакоммиченные правки не попадут в установку: ${checkout}"
    fi
  fi

  # Детект установок: стандартные каталоги, установленная копия, из которой
  # запущен bs, и каталог из обёртки `bs` в PATH (нестандартный --lib).
  # Detect installs: the standard directories, the installed copy bs runs
  # from, and the directory named by the `bs` wrapper in PATH (custom --lib).
  if (( explicit == 0 )); then
    local -a found=("${HOME}/.local/lib/bs" "/usr/local/lib/bs")
    is::dir "${BS_ROOT}/tests" || found+=("${BS_ROOT}")
    local wrapper wrapper_root
    while IFS= read -r wrapper; do
      wrapper_root="$(update_wrapper_root "${wrapper}")"
      [[ -n "${wrapper_root}" ]] && found+=("${wrapper_root}")
    done < <(type -aP bs 2>/dev/null)
    local dir seen=$'\n'
    for dir in "${found[@]}"; do
      dir="${dir%/}"
      is::dir "${dir}/core" || continue
      [[ "${dir}" == "${checkout%/}" ]] && continue
      [[ "${seen}" == *$'\n'"${dir}"$'\n'* ]] && continue
      seen+="${dir}"$'\n'
      targets+=("${dir}")
    done
  fi

  if (( ${#targets[@]} == 0 )); then
    die "update: no BS installs found (use --local, --system or --lib DIR)"
  fi
  local source_label="${from}"
  if (( github == 1 )); then
    source_label="${repo%.git}@${ref}"
    log::info "fetching ${source_label}"
    update_fetch "${repo}" "${ref}"
    from="${UPDATE_FETCH_DIR}/src"
  fi
  is::dir "${from}/core" || die "update: source is not a BS repo: ${source_label}"

  local target ok=0
  local -a same_paths=() miss_paths=() ro_paths=() uptodate_paths=()
  for target in "${targets[@]}"; do
    if ! is::dir "${target}"; then
      log::warn "update: target not found, skipping: ${target}"
      miss_paths+=("${target}")
      continue
    fi
    if [[ "${from}" == "${target}" ]]; then
      # В финальную рамку, а не WARN в цикле: «ничего не обновлено» — это
      # не ошибка, а приглашение запустить update из репозитория.
      # Collected for the final box, not a per-target WARN: "nothing updated"
      # is not an error but an invitation to run update from the repo.
      same_paths+=("${target}")
      continue
    fi
    # Уже актуально: содержимое совпадает — копировать нечего (повторный
    # запуск update не должен давать «UPDATE COMPLETE»).
    # Already up to date: identical content — nothing to copy (a re-run of
    # update must not claim "UPDATE COMPLETE").
    if cmp -s "${from}/bs" "${target}/bs" \
       && diff -rq "${from}/bootstrap" "${target}/bootstrap" >/dev/null 2>&1 \
       && diff -rq "${from}/core" "${target}/core" >/dev/null 2>&1 \
       && diff -rq "${from}/lib" "${target}/lib" >/dev/null 2>&1; then
      uptodate_paths+=("${target}")
      continue
    fi
    # Нет прав на запись: в терминале повышаем права через sudo сами (sudo
    # спросит пароль); без терминала — только предупреждение.
    # Not writable: in a terminal elevate with sudo ourselves (sudo asks for
    # the password); without a terminal just warn.
    local -a as_root=()
    if ! [[ -w "${target}" ]]; then
      if [[ -t 0 ]] && utils::has sudo; then
        log::info "update: ${target} needs root — using sudo / нужны права root"
        as_root=(sudo)
      else
        log::warn "update: target not writable: ${target} (try: sudo bs update --system)"
        ro_paths+=("${target}")
        continue
      fi
    fi
    log::info "syncing ${source_label} -> ${target}"
    # Атомарная замена: копируем во временный каталог, затем mv (rename).
    # Atomic replace: copy to a temp dir, then mv (rename) — a running `bs`
    # keeps the old inode instead of reading a half-truncated file.
    local tmp_dir
    tmp_dir="${target}/.update.$$"
    if ! { "${as_root[@]}" rm -rf -- "${tmp_dir}" && "${as_root[@]}" mkdir -p -- "${tmp_dir}"; }; then
      log::warn "update: cannot write to ${target} (try: sudo bs update --system)"
      ro_paths+=("${target}")
      continue
    fi
    if ! "${as_root[@]}" cp -a "${from}/bootstrap" "${from}/core" "${from}/lib" "${from}/bs" "${tmp_dir}/"; then
      "${as_root[@]}" rm -rf -- "${tmp_dir}"
      log::error "update: copy failed for ${target} (source files intact)"
      continue
    fi
    "${as_root[@]}" mv -f -- "${tmp_dir}/bs" "${target}/bs"
    "${as_root[@]}" rm -rf -- "${target}/bootstrap" && "${as_root[@]}" mv -f -- "${tmp_dir}/bootstrap" "${target}/bootstrap"
    "${as_root[@]}" rm -rf -- "${target}/core" && "${as_root[@]}" mv -f -- "${tmp_dir}/core" "${target}/core"
    "${as_root[@]}" rm -rf -- "${target}/lib" && "${as_root[@]}" mv -f -- "${tmp_dir}/lib" "${target}/lib"
    "${as_root[@]}" rmdir -- "${tmp_dir}" 2>/dev/null || true
    update_manifest "${target}" "${from}" "${source_label}" "${as_root[@]}"
    ok=1
    if (( verbose == 1 )); then
      log::info "  files: $(find "${from}/core" "${from}/lib" -name '*.sh' | wc -l) modules copied"
    fi
  done

  if (( ok == 1 )); then
    log::header "UPDATE COMPLETE / ОБНОВЛЕНИЕ ЗАВЕРШЕНО"
    log::success "sync done — changes are live without reinstalling"
    return 0
  fi

  # Итоговая рамка вместо сырого ERROR: понятно, что случилось и что делать.
  # A framed summary instead of a raw ERROR: clear what happened and what to do.
  local -a reasons=()
  local p
  for p in "${same_paths[@]}"; do
    reasons+=("• ${p} — вы запустили bs из установленной копии: источник совпадает с целью / running from an installed copy: source equals target")
  done
  for p in "${miss_paths[@]}"; do
    reasons+=("• ${p} — каталог не найден / directory not found")
  done
  for p in "${ro_paths[@]}"; do
    reasons+=("• ${p} — нет прав на запись / not writable (try: sudo bs update --system)")
  done
  for p in "${uptodate_paths[@]}"; do
    reasons+=("• ${p} — уже актуально / already up to date")
  done
  if (( ${#same_paths[@]} > 0 )); then
    reasons+=("")
    reasons+=("Запустите из каталога репозитория / Run from the repo directory:")
    reasons+=("  cd <repo> && ./bs update")
    reasons+=("или укажите источник / or pass the source:")
    reasons+=("  bs update --from <repo-path>")
    reasons+=("или обновитесь с GitHub / or update from GitHub:")
    reasons+=("  bs update --github")
  fi
  update_box "ОБНОВЛЕНИЙ НЕТ / NO UPDATES" "${reasons[@]}"
  # Пропуск «источник == цель» или «уже актуально» — это не ошибка, а отказ
  # от работы; ошибка — только не найденная/недоступная цель.
  # same-as-source and up-to-date skips are not failures; a missing or
  # non-writable target is.
  if (( ${#miss_paths[@]} == 0 && ${#ro_paths[@]} == 0 )); then
    return 0
  fi
  exit 1
}

# ==========================================
# bs uninstall: remove installed BS copies / удаление установленных копий
# ==========================================

uninstall_cmd() {
  local -a targets=()
  local explicit=0
  local verbose=0

  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --local)
        explicit=1
        targets+=("${HOME:-}/.local/lib/bs")
        shift ;;
      --system)
        explicit=1
        targets+=("/usr/local/lib/bs")
        shift ;;
      --lib)
        shift
        [[ $# -ge 1 ]] || die "uninstall: --lib requires a target directory"
        explicit=1
        targets+=("$1")
        shift ;;
      -v|--verbose)
        verbose=1
        shift ;;
      -h|--help)
        printf 'Usage: bs uninstall [--local] [--system] [--lib DIR] [-v]\n\n'
        printf 'Removes installed BS copies (lib tree + wrapper).\n'
        printf '  --local   remove ~/.local/lib/bs and its wrapper in ~/.local/bin\n'
        printf '  --system  remove /usr/local/lib/bs and its wrapper (needs root)\n'
        printf '  --lib DIR remove a custom install directory\n'
        printf 'Without flags: remove every detected install (local + system).\n'
        printf 'Safety: only directories that are unmistakably BS installs are\n'
        printf 'removed; a wrapper is deleted only when it points back at the target.\n'
        printf 'PATH lines in rc files are cleaned by: ./install.sh --local uninstall\n'
        return 0 ;;
      *)
        die "uninstall: unknown argument: $1" ;;
    esac
  done

  # Детект установок / Detect installs
  if (( explicit == 0 )); then
    if is::dir "${HOME:-}/.local/lib/bs"; then
      targets+=("${HOME:-}/.local/lib/bs")
    fi
    if is::dir "/usr/local/lib/bs"; then
      targets+=("/usr/local/lib/bs")
    fi
  fi

  if (( ${#targets[@]} == 0 )); then
    die "uninstall: no BS installs found (use --local, --system or --lib DIR)"
  fi

  local target ok=0
  for target in "${targets[@]}"; do
    target="${target%/}"   # нормализация: убрать завершающий слеш / strip trailing slash
    # Безопасность: удаляем только каталоги, которые однозначно являются BS
    # Safety: only remove directories that are unmistakably BS installs
    if [[ ! -f "${target}/bs" || ! -f "${target}/bootstrap/init.sh" ]]; then
      log::warn "uninstall: not a BS install, skipping: ${target}"
      continue
    fi
    # Никогда не удалять исходный чекаут: у него есть .git или tests/, у
    # установленной копии их нет. Сравнивать с BS_ROOT нельзя — у bs,
    # запущенного из установки, BS_ROOT и есть эта установка.
    # Never remove the source checkout: it has .git or tests/, an installed
    # copy has neither. Comparing with BS_ROOT is wrong — for a bs started
    # from an install, BS_ROOT is that very install.
    if [[ -e "${target}/.git" || -d "${target}/tests" ]]; then
      log::warn "uninstall: refusing to remove the BS source checkout: ${target}"
      continue
    fi
    if ! [[ -w "${target}" ]]; then
      log::warn "uninstall: target not writable: ${target} (try: sudo bs uninstall --system)"
      continue
    fi

    local bin_dir wrapper
    # Обёртка — из манифеста установки, иначе выводится из пути
    # The wrapper comes from the install manifest, else derived from the path
    wrapper="$(install_info_get "${target}" bin)"
    [[ -n "${wrapper}" ]] || wrapper="${target%/lib/bs}/bin/bs"
    bin_dir="${wrapper%/*}"
    log::info "uninstalling ${target}"
    # Wrapper удаляется только если указывает на этот target
    # Wrapper is removed only when it points back at this install
    if [[ -f "${wrapper}" ]] && grep -Fq "BS_ROOT=\"${target}\"" "${wrapper}" 2>/dev/null; then
      rm -f -- "${wrapper}"
      if (( verbose == 1 )); then
        log::info "  removed: ${wrapper}"
      fi
    elif [[ -f "${wrapper}" ]]; then
      log::warn "uninstall: wrapper not matching this install, left in place: ${wrapper}"
    fi

    # rm -rf на защищённый target безопасен: выше уже проверено, что это
    # настоящая BS-установка (bs + bootstrap/init.sh), не чекаут (без .git
    # и tests/) и записываемый. Файл с именем /x/lib/bs не пройдёт
    # проверку -f "${target}/bs" и будет пропущен.
    # rm -rf on the guarded target is safe: checks above already proved it is
    # a real BS install (bs + bootstrap/init.sh), not a checkout (no .git,
    # no tests/) and is writable. A *file* named /x/lib/bs fails the
    # -f "${target}/bs" test and is skipped.
    rm -rf -- "${target}"
    if (( verbose == 1 )); then
      log::info "  removed: ${target}"
    fi
    # rmdir удаляет только пустой bin_dir; при нестандартном --lib пути
    # (не .../lib/bs) bin_dir выводится неверно — но каталога нет после
    # rm -rf, rmdir молча падает, || true глушит. Чужие файлы не трогаются.
    # rmdir removes only an empty bin_dir; for a non-standard --lib path
    # (not .../lib/bs) bin_dir is derived wrongly — but the dir is gone
    # after rm -rf, rmdir fails silently and || true swallows it. Foreign
    # files are never touched.
    rmdir -- "${bin_dir}" 2>/dev/null || true
    ok=1
  done

  (( ok == 1 )) || die "uninstall: nothing removed — target is not a BS install or not writable (see messages above)"
  log::success "uninstall done"
}

ts_cmd() {
  case "${1:-}" in
    -h|--help|"")
      printf 'Usage: bs ts <command> [args]\n\n'
      printf 'TypeScript toolchain and a local mini stack (thriller).\n\n'
      printf '  doctor [dir]     TS environment summary\n'
      printf '  validate [dir]   tsc / eslint / prettier gate\n'
      printf '  port-free PORT   is TCP port free\n'
      printf '  init [dir]       scaffold api + fixtures + public\n'
      printf '  up [dir]         start api (and web if present)\n'
      printf '  down             stop\n'
      printf '  status           pids / ports / alive\n'
      printf '  logs [api|web]   last log lines\n'
      return 0 ;;
  esac
  local -r sub="$1"
  shift || true
  case "${sub}" in
    doctor)
      load "lib/ts/toolchain"
      ts::toolchain::doctor "$@" ;;
    validate)
      load "lib/ts/toolchain"
      ts::toolchain::validate "$@" ;;
    port-free)
      load "lib/ts/toolchain"
      ts::toolchain::port_free "$@" ;;
    init|up|down|status|logs)
      load "lib/ts/stack"
      "ts::stack::${sub}" "$@" ;;
    *)
      die "ts: unknown command: ${sub} (see: bs ts --help)" ;;
  esac
}

# 7. Shebang-режим
# Если bs вызван как интерпретатор shebang'а (#!/usr/bin/env bs),
# первый аргумент — путь к существующему скрипту, а не команда.
if [[ $# -ge 1 && -f "$1" ]]; then
  case "$1" in
    help|-h|--help|version|env|list|lang-doc|lsp|chat|sync|rfc|api|ts|audit|doctor|run|build|repl|calc|init-shell|update|uninstall) : ;;
    *) BS_SHEBANG=1 ;;
  esac
fi
if [[ "${BS_SHEBANG:-0}" == "1" ]]; then
  [[ $# -ge 1 ]] || die "shebang mode: script path required"
  run_cmd "$@"
  # Функция run_cmd сама сделает exec, поэтому дальше не продолжаем.
fi

# 8. Обычный CLI-диспетчер
case "${1:-help}" in
  help|-h|--help) help ;;
  version)        version ;;
  env)            env_cmd ;;
  list)           list_cmd ;;
  lang-doc)       shift; lang_doc_cmd "$@" ;;
  lsp)            shift; lsp_cmd "$@" ;;
  chat)           shift; chat_cmd "$@" ;;
  update)         shift; update_cmd "$@" ;;
  uninstall)      shift; uninstall_cmd "$@" ;;
  sync)           shift; log::warn "sync is deprecated — use: bs update" && update_cmd "$@" ;;
  rfc)            shift; rfc_cmd "$@" ;;
  api)            shift; api_cmd "$@" ;;
  ts)             shift; ts_cmd "$@" ;;
  audit)          shift; audit_cmd "$@" ;;
  doctor)         shift || true; doctor_cmd "$@" ;;
  run)            shift; run_cmd "$@" ;;
  build)          shift; build_cmd "$@" ;;
  repl)           shift
                  if ! source -- "${BS_ROOT}/core/repl.sh"; then
                    die "repl: core/repl.sh not found"
                  fi
                  repl::main "$@" ;;
  calc)           shift
                  if ! source -- "${BS_ROOT}/core/calc.sh"; then
                    die "calc: core/calc.sh not found"
                  fi
                  calc::main "$@" ;;
  init-shell)     init_shell_cmd ;;
  *)              die "unknown command: $1" ;;
esac
