bs::__resolve_root() {  # Функция для определения корневого каталога фреймворка

	# ЛОКАЛЬНАЯ ПЕРЕМЕННАЯ / LOCAL VARIABLE:
	# bin_dir - локальная переменная для этой функции
	# bin_dir - local variable for this function

	local bin_dir  # Объявление локальной переменной для хранения пути к каталогу исполняемых файлов
		
	bin_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"  # Получаем абсолютный путь к каталогу исполняемого файла bs

	# 1. Проверка: локальный запуск из репозитория
	#	 Check: local run from repository

	if [[ -f "${bin_dir}/../bs" ]] && [[ -d "${bin_dir}/../bootstrap" ]]; then  # Проверяем, является ли это локальным запуском из репозитория
		echo "$(cd -- "${bin_dir}/.." && pwd)"  # Возвращаем путь к корню локального репозитория
		return 0  # Возвращаем успешный код завершения
	fi

	# 2. Проверка: системная установка (/usr/local/lib/bs)
	#	 Check: system installation (/usr/local/lib/bs)

	if [[ -d "/usr/local/lib/bs" ]] && [[ -f "/usr/local/lib/bs/bootstrap/init.sh" ]]; then  # Проверяем системную установку
		echo "/usr/local/lib/bs"  # Выводим путь к системной установке
		return 0  # Возвращаем успешный код завершения
	fi

	# 3. Проверка: локальная установка (~/.local/lib/bs)
	#	 Check: local installation (~/.local/lib/bs)

	# ЛОКАЛЬНАЯ ПЕРЕМЕННАЯ / LOCAL VARIABLE:
	# local_path - локальная переменная для этой функции
	# local_path - local variable for this function

	local local_path="${HOME}/.local/lib/bs"  # Объявляем переменную для пути к локальной установке

	if [[ -d "${local_path}" ]] && [[ -f "${local_path}/bootstrap/init.sh" ]]; then  # Проверяем локальную установку
		echo "${local_path}"  # Выводим путь к локальной установке
		return 0  # Возвращаем успешный код завершения
	fi

	# 4. Если ничего не найдено - используем fallback (для обратной совместимости) но выводим предупреждение
	# 	 If nothing found - use fallback (for backward compatibility) but output warning

	echo "/usr/local/lib/bs"  # Возвращаем путь по умолчанию
	return 1  # Возвращаем код ошибки, если подходящей установки не найдено

}

