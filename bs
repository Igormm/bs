# while IFS - [Variable description]
#
		while IFS= read -r -d '' module; do  # Читаем каждый найденный файл

			# Получаем относительный путь от BOSA_ROOT/lib / Get relative path from BOSA_ROOT/lib

#
# ПЕРЕМЕННАЯ / VARIABLE:
# rel_path - [Описание переменной]
# rel_path - [Variable description]
#
			rel_path="${module#${BOSA_ROOT}/lib/}"  # Удаляем префикс пути до каталога lib

			# Убираем расширение .sh / Remove .sh extension

#
# ПЕРЕМЕННАЯ / VARIABLE:
# rel_path - [Описание переменной]
# rel_path - [Variable description]
#
			rel_path="${rel_path%.sh}"  # Удаляем расширение .sh

			echo "  lib/${rel_path}"  # Выводим путь к модулю

		done < <(find "${BOSA_ROOT}/lib" -type f -name "*.sh" -print0 2>/dev/null || true)  # Находим все .sh файлы в lib и передаем их в цикл

	fi

	exit 0  # Выходим с успешным кодом

	;;

esac



# --- shebang mode / режим shebang ---

#
# ПЕРЕМЕННАЯ / VARIABLE:
# SCRIPT_PATH - [Описание переменной]
# SCRIPT_PATH - [Variable description]
#
SCRIPT_PATH="${1-}"  # Сохраняем первый аргумент как путь к скрипту

shift || true  # Удаляем первый аргумент из списка, если он был



if [[ -z "${SCRIPT_PATH}" ]]; then  # Проверяем, задан ли путь к скрипту

	echo "bs: не указан путь к скрипту (shebang mode)" >&2  # Выводим ошибку на stderr

	echo "bs: script path not specified (shebang mode)" >&2  # Выводим ошибку на английском

	exit 2  # Выходим с кодом ошибки

fi



if [[ ! -f "${SCRIPT_PATH}" ]]; then  # Проверяем, существует ли файл скрипта

	echo "bs: скрипт не найден: ${SCRIPT_PATH}" >&2  # Выводим ошибку на stderr

	echo "bs: script not found: ${SCRIPT_PATH}" >&2  # Выводим ошибку на английском

	exit 2  # Выходим с кодом ошибки

fi



# Запускаем bash так, чтобы: / Run bash so that:

# - сначала подключить bs (bs/bs) / - first connect bs (bs/bs)

# - затем source'нуть целевой скрипт (он выполнится с доступными функциями) / - then source target script (it will execute with available functions)

exec bash -c '  # Заменяем текущий процесс новым экземпляром bash

  set -euo pipefail  # Устанавливаем безопасные настройки оболочки

  source "'"${SCRIPT_PATH}"'"  # Подключаем указанный пользовательский скрипт

' bash "$@"  # Передаем оставшиеся аргументы в новый процесс bash

sh "$@"  # Эта строка никогда не будет выполнена из-за exec выше