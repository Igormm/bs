#!/bin/sh
# shellcheck shell=sh
# @shell posix — валидный POSIX sh: диспетчер команд; help, version, env, list, calc работают без bash, остальным нужен bash 4.2+ / valid POSIX sh: the command dispatcher; help, version, env, list, calc work without bash, the others need bash 4.2+
# @tier core — builtins and the commands of the kernel; works everywhere
#
#  BS Framework – STAGE-2 UNIFIED ENTRY-POINT / INTERPRETER
#  Назначение / Purpose:
#    - инициализировать окружение фреймворка;
#    - обрабатывать пользовательские команды (run, doctor, list …);
#    - работать как shebang-интерпретатор (#!/usr/bin/env bs).
#  Зависимости: bootstrap/init.sh, структура каталогов core/, lib/ (опционально, но doctor
#              ругается). В bash 4.2+ работают все команды; без bash — те, что уже на POSIX
#              (bootstrap/cli.sh), остальные отвечают, что им нужен bash.
#  Dependencies: bootstrap/init.sh, the core/ and lib/ layout (optional, but doctor complains).
#              In bash 4.2+ every command works; without bash only the ones that are POSIX
#              already (bootstrap/cli.sh) do, the others say they need bash.
#

# Точка входа умеет работать без bash: трамплин перезапускает её в bash 4.2+, если он есть,
# иначе она остаётся в текущей оболочке (BS_KERNEL_MODE=posix).
# The entry point can run without bash: the trampoline re-runs it in a bash 4.2+ when there is
# one and otherwise it stays in the current shell (BS_KERNEL_MODE=posix).
BS_POSIX_ENTRY=1

# --- POSIX-пролог (валиден в sh/dash/ash/zsh/bash) / POSIX prologue ---------
# Если запущены не bash 4+ (sh install.sh, zsh ./bs, bash 3.2, bash как sh),
# перезапускаемся в подходящем bash или объясняем, что поставить. В bash 4+
# это одна проверка. Текст пролога одинаков во всех точках входа (тест).
# Unless run by bash 4+ (sh install.sh, zsh ./bs, bash 3.2, bash as sh), re-run
# in a capable bash or explain what to install. In bash 4+ it is one test.
# zsh меняет $0 внутри подключаемого файла — путь точки входа запоминаем здесь
# zsh changes $0 inside a sourced file — the entry point path is saved here
__bs_s=$0
__bs_p=$0
# shell-gate: единственное место, где точка входа узнаёт свой путь (POSIX, до реестра)
# shell-gate: the one place an entry point learns its own path (POSIX, before the registry)
__bs_r=$(readlink -f -- "$0" 2>/dev/null) && [ -n "$__bs_r" ] && __bs_p=$__bs_r
case $__bs_p in */*) __bs_p=${__bs_p%/*} ;; *) __bs_p=. ;; esac
BS_ENTRY_DIR=$(cd -- "$__bs_p" >/dev/null 2>&1 && pwd -P) || BS_ENTRY_DIR=$__bs_p
# Реестр оболочек отвечает, годится ли эта оболочка в хозяева
# The shell registry answers whether this shell can be the host
# shellcheck disable=SC1091
. "$__bs_p/bootstrap/shell.sh"
if ! bs_shell_host_ok; then
  # shellcheck disable=SC1091
  . "$__bs_p/bootstrap/trampoline.sh"
fi
unset __BS_TRAMPOLINE __bs_p __bs_r __bs_s
# --- конец пролога / end of the prologue ------------------------------------
unset BS_POSIX_ENTRY

# PATH вызвавшей оболочки. Загрузка ядра дописывает ~/.local/bin в PATH
# ЭТОГО процесса (bs_append_local_bin_to_path), поэтому `bs where` сверяется
# с этой копией, а не с PATH процесса.
# The PATH of the calling shell. Loading the core prepends ~/.local/bin to the
# PATH of THIS process (bs_append_local_bin_to_path), so `bs where` checks
# this copy, not the process PATH.
BS_CALLER_PATH="${PATH}"

# 1. Каталог entry-point'а — нужен до загрузки чего-либо
# readlink -f: bs можно вызвать по символической ссылке (~/bin/bs -> .../bs)
BS_DIR="${BS_ENTRY_DIR}"

# 2. Pre-kernel: POSIX-часть (base.sh) везде, bash-слой (bs.sh) только в bash.
#    Строгий режим включается именованной pre-kernel функцией bs_strict.
#    Pre-kernel: the POSIX part (base.sh) everywhere, the bash layer (bs.sh) in bash only.
#    Strict mode is enabled via the named pre-kernel helper bs_strict.
if [ -f "${BS_DIR}/bootstrap/base.sh" ]; then
  # shellcheck disable=SC1090,SC1091
  . "${BS_DIR}/bootstrap/base.sh"
  case "$(bs_shell_family)" in
    bash)
      if [ -f "${BS_DIR}/bootstrap/bs.sh" ]; then
        # shellcheck disable=SC1090,SC1091
        . "${BS_DIR}/bootstrap/bs.sh"
      else
        printf 'ERROR: bootstrap/bs.sh not found in %s\n' "$BS_DIR" >&2
        exit 2
      fi ;;
    *)
      # POSIX-часть команд: в bash её подключает bs.sh / the POSIX part of the commands: in bash bs.sh sources it
      # shellcheck disable=SC1090,SC1091
      . "${BS_DIR}/bootstrap/cli.sh" ;;
  esac
  bs_strict
  # Версию bash уже проверил POSIX-пролог (bs_shell_host_ok) — повторять нечего
  # The POSIX prologue (bs_shell_host_ok) has already checked the bash version
else
  printf 'ERROR: bootstrap/base.sh not found in %s\n' "$BS_DIR" >&2
  exit 2
fi

# 3. Определение BS_ROOT (если ещё не задан)
if [ -z "${BS_ROOT:-}" ]; then
  # Если bs запущен из репо-корня, bootstrap/init.sh рядом
  if [ -f "${BS_DIR}/bootstrap/init.sh" ]; then
    BS_ROOT=$BS_DIR
  else
    # Ищем в стандартных местах
    for dir in "${HOME:-}/.local/lib/bs" "${BS_SYSTEM_PREFIX:-/usr/local}/lib/bs"; do
      if [ -f "${dir}/bootstrap/init.sh" ]; then
        BS_ROOT=$dir
        break
      fi
    done
  fi
  export BS_ROOT
fi

# 4. BS_HOME и тишина по умолчанию / BS_HOME and quiet-by-default
# BS_HOME: историческое расхождение с BS_ROOT в lib-модулях;
# задаём единообразно, чтобы скриптам не приходилось экспортировать его руками
# BS_HOME: historical mismatch with BS_ROOT in lib modules;
# set it uniformly so scripts do not have to export it by hand
: "${BS_HOME:=${BS_ROOT}}"
export BS_HOME

# По умолчанию не шумим при загрузке ядра: вывод скрипта важнее
# Quiet by default when loading core: the script's own output matters more
: "${BS_SILENT:=1}"
export BS_SILENT

# 4b. Лёгкие команды не тянут всё ядро / Lightweight commands skip the whole kernel
# help, version, env, list, init-shell и shebang живут в bootstrap/cli.sh и
# обходятся без args/config/deps; kernel.sh в минимальном режиме грузит только
# их транзитивные зависимости. run/build/call и остальные — полное ядро.
# help, version, env, list, init-shell and shebang live in bootstrap/cli.sh and
# do not need args/config/deps; in minimal mode kernel.sh loads only their
# transitive dependencies. run/build/call and the rest get the full kernel.
case "${1:-help}" in
  help|-h|--help|version|env|list|init-shell|shebang) BS_KERNEL_MINIMAL=1 ;;
esac
: "${BS_KERNEL_MINIMAL:=0}"
export BS_KERNEL_MINIMAL

# 4c. run и shebang: не грузим ядро дважды / run and shebang: do not load the kernel twice
# `bs run script` и `#!/usr/bin/env bs` раньше загружали полное ядро в этом
# процессе и ещё раз в дочернем bash. bs_cli_maybe_exec_script сразу делает exec
# в bash, который грузит ядро один раз; внешний процесс остаётся на pre-kernel
# helpers. Если аргументы — не run и не файл, функция возвращает 1.
# `bs run script` and `#!/usr/bin/env bs` used to load the full kernel in this
# process and again in the child bash. bs_cli_maybe_exec_script execs into the
# bash that loads the kernel once; the outer process stays on pre-kernel helpers.
# If the arguments are neither run nor a file, the function returns 1.
if bs_cli_maybe_exec_script "$@"; then
  exit 0
fi

# 5. Загрузка ядра
if [ ! -f "${BS_ROOT}/bootstrap/init.sh" ]; then
  printf 'ERROR: bootstrap/init.sh not found in BS_ROOT=%s\n' "$BS_ROOT" >&2
  exit 2
fi
# CLI всегда загружает ядро заново, даже если окружение уже
# инициализировано (BS_INITIALIZED из sourced-сессии иначе пропустит загрузку)
unset BS_INITIALIZED
# shellcheck disable=SC1090,SC1091
. "${BS_ROOT}/bootstrap/init.sh"

# Сводки о запущенной копии для bs update / bs uninstall (заполняются лениво, bash-слой)
# Summaries of the running copy for bs update / bs uninstall (filled lazily, the bash layer)
UPDATE_RUN_INFO=""
UPDATE_RUN_BLOCK=""
UPDATE_RUN_SHORT=""

# EXIT-trap для стека cleanup (ядро при source trap больше не ставит)
# EXIT trap for the cleanup stack (core no longer sets it when sourced)
bs_errorhandler_setup_trap

# 6b. Глобальный флаг --strict-shell: tier модулей lib/ против оболочки запуска
# Global flag --strict-shell: lib/ module tiers against the shell BS was started from
: "${BS_ORIGIN_SHELL:=bash}"
export BS_ORIGIN_SHELL
# --strict-shell[=ОБОЛОЧКА]: без имени — против оболочки, из которой реально запущен bs;
# с именем (--strict-shell=dash или --strict-shell dash) — против УКАЗАННОЙ оболочки: «будет ли
# это работать в dash», где бы ни запустили. Имя отдельным словом принимается, только если это
# известная оболочка (иначе это команда: `bs --strict-shell run x`).
# --strict-shell[=SHELL]: without a name — against the shell bs was really started from; with a
# name (--strict-shell=dash or --strict-shell dash) — against the NAMED shell: "will this work in
# dash", wherever it is started. A separate-word name is taken only if it is a known shell
# (otherwise it is a command: `bs --strict-shell run x`).
case "${1:-}" in
  --strict-shell|--strict-shell=*)
    export BS_SHELL_STRICT=1
    __bs_strict_name=""
    case "${1}" in
      --strict-shell=*)
        __bs_strict_name="${1#--strict-shell=}"
        shift
        if [ -z "${__bs_strict_name}" ]; then
          bs_cli_die "--strict-shell=: shell name is empty (known: bash zsh ash dash sh ksh mksh oksh osh fish nu)"
        fi ;;
      *)
        shift
        if [ $# -ge 1 ] && [ "$(bs_shell_of_name "$1")" != "unknown" ]; then
          __bs_strict_name="$1"
          shift
        fi ;;
    esac
    if [ -n "${__bs_strict_name}" ]; then
      __bs_strict_family="$(bs_shell_of_name "${__bs_strict_name}")"
      if [ "${__bs_strict_family}" = "unknown" ]; then
        bs_cli_die "--strict-shell: unknown shell: ${__bs_strict_name} (known: bash zsh ash dash sh ksh mksh oksh osh fish nu)"
      fi
      BS_ORIGIN_SHELL="${__bs_strict_family}"
      export BS_ORIGIN_SHELL
      export BS_SHELL_STRICT_NAMED=1
    fi
    unset __bs_strict_name __bs_strict_family ;;
esac

# 7. Shebang-режим
# Если bs вызван как интерпретатор shebang'а (#!/usr/bin/env bs),
# первый аргумент — путь к существующему скрипту, а не команда.
if [ $# -ge 1 ] && [ -f "$1" ]; then
  case "$1" in
    help|-h|--help|version|env|list|lang-doc|lsp|chat|sync|rfc|api|ts|audit|doctor|run|build|repl|calc|init-shell|shebang|call|update|uninstall|where) : ;;
    *) BS_SHEBANG=1 ;;
  esac
fi
if [ "${BS_SHEBANG:-0}" = "1" ]; then
  if [ $# -lt 1 ]; then bs_cli_die "shebang mode: script path required"; fi
  bs_cli_delegate run bs::cli::run_cmd "$@"
  # Функция bs::cli::run_cmd сама сделает exec, поэтому дальше не продолжаем.
fi

# 8. Обычный CLI-диспетчер
case "${1:-help}" in
  help|-h|--help)
    shift || true
    if [ $# -ge 1 ]; then
      bs_cli_help_cmd "$1"
    else
      bs_cli_help
    fi
    ;;
  version)        shift; bs_cli_version_cmd "$@" ;;
  env)            bs_cli_env_cmd ;;
  list)           bs_cli_list_cmd ;;
  lang-doc)       shift; bs_cli_delegate lang-doc bs::cli::lang_doc_cmd "$@" ;;
  lsp)            shift; bs_cli_delegate lsp bs::cli::lsp_cmd "$@" ;;
  chat)           shift; bs_cli_delegate chat bs::cli::chat_cmd "$@" ;;
  update)         shift; bs_cli_update_cmd "$@" ;;
  uninstall)      shift; bs_cli_uninstall_cmd "$@" ;;
  where)          shift; bs_cli_where_cmd "$@" ;;
  sync)           shift; bs_log_warn "sync is deprecated — use: bs update"; bs_cli_update_cmd "$@" ;;
  rfc)            shift; bs_cli_delegate rfc bs::cli::rfc_cmd "$@" ;;
  api)            shift; bs_cli_delegate api bs::cli::api_cmd "$@" ;;
  ts)             shift; bs_cli_delegate ts bs::cli::ts_cmd "$@" ;;
  audit)          shift; bs_cli_delegate audit bs::cli::audit_cmd "$@" ;;
  doctor)         shift || true; bs_cli_doctor_cmd "$@" ;;
  run)            shift; bs_cli_delegate run bs::cli::run_cmd "$@" ;;
  build)          shift; bs_cli_delegate build bs::cli::build_cmd "$@" ;;
  repl)           shift
                  if [ "$BS_KERNEL_MODE" != full ]; then bs_cli_need_bash repl; fi
                  if ! bs_load "lib/ui/repl"; then
                    bs_cli_die "repl: lib/ui/repl.sh not found"
                  fi
                  repl::main "$@" ;;
  calc)           shift
                  if ! bs_load "core/calc"; then
                    bs_cli_die "calc: core/calc.sh not found"
                  fi
                  bs_calc_main "$@" ;;
  init-shell)     shift; bs_cli_init_shell_cmd "$@" ;;
  shebang)        shift; bs_cli_shebang_cmd "$@" ;;
  call)           shift; bs_cli_call_cmd "$@" ;;
  *)              bs_cli_die "unknown command: $1" ;;
esac
