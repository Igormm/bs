#!/usr/bin/env bash
# @shell bash4 — bash 4.2+ file behind a POSIX prologue: sh/dash/zsh/bash 3.2 re-run it in bash (bootstrap/trampoline.sh)
# @shell bash4 — файл bash 4.2+ за POSIX-прологом: sh/dash/zsh/bash 3.2 перезапускают его в bash (bootstrap/trampoline.sh)
#
#  BS Framework – STAGE-2 UNIFIED ENTRY-POINT / INTERPRETER
#  Назначение / Purpose:
#    - инициализировать окружение фреймворка;
#    - обрабатывать пользовательские команды (run, doctor, list …);
#    - работать как shebang-интерпретатор (#!/usr/bin/env bs).
#  Зависимости: bash 4.0+, bootstrap/init.sh, структура каталогов
#              core/, lib/ (опционально, но doctor ругается).
#

# --- POSIX-пролог (валиден в sh/dash/ash/zsh/bash) / POSIX prologue ---------
# Если запущены не bash 4+ (sh install.sh, zsh ./bs, bash 3.2, bash как sh),
# перезапускаемся в подходящем bash или объясняем, что поставить. В bash 4+
# это одна проверка. Текст пролога одинаков во всех точках входа (тест).
# Unless run by bash 4+ (sh install.sh, zsh ./bs, bash 3.2, bash as sh), re-run
# in a capable bash or explain what to install. In bash 4+ it is one test.
if [ -z "${BASH_VERSION:-}" ] || [ "${BASH_VERSINFO:-0}" -lt 4 ] \
   || { case ":${SHELLOPTS:-}:" in *:posix:*) true ;; *) false ;; esac; }; then
  # zsh меняет $0 внутри подключаемого файла — путь точки входа запоминаем здесь
  # zsh changes $0 inside a sourced file — the entry point path is saved here
  __bs_s=$0
  __bs_p=$0
  __bs_r=$(readlink -f -- "$0" 2>/dev/null) && [ -n "$__bs_r" ] && __bs_p=$__bs_r
  case $__bs_p in */*) __bs_p=${__bs_p%/*} ;; *) __bs_p=. ;; esac
  # shellcheck disable=SC1091
  . "$__bs_p/bootstrap/trampoline.sh"
fi
unset __BS_TRAMPOLINE __bs_p __bs_r __bs_s
# --- конец пролога / end of the prologue ------------------------------------

# PATH вызвавшей оболочки. Загрузка ядра дописывает ~/.local/bin в PATH
# ЭТОГО процесса (bs::append_local_bin_to_path), поэтому `bs where` сверяется
# с этой копией, а не с PATH процесса.
# The PATH of the calling shell. Loading the core prepends ~/.local/bin to the
# PATH of THIS process (bs::append_local_bin_to_path), so `bs where` checks
# this copy, not the process PATH.
BS_CALLER_PATH="${PATH}"

# 1. Каталог entry-point'а — нужен до загрузки чего-либо
# readlink -f: bs можно вызвать по символической ссылке (~/bin/bs -> .../bs)
BS_DIR=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")")" &>/dev/null && pwd)

# 2. Pre-kernel root namespace: shell version gate (bash 3.2-compatible)
#    Строгий режим включается именованной pre-kernel функцией bs::strict.
#    Strict mode is enabled via the named pre-kernel helper bs::strict.
if [[ -f "${BS_DIR}/bootstrap/bs.sh" ]]; then
  source "${BS_DIR}/bootstrap/bs.sh"
  bs::strict
  bs::shell::ensure_version 4 || exit 1
else
  printf 'ERROR: bootstrap/bs.sh not found in %s\n' "$BS_DIR" >&2
  exit 2
fi

# 3. Определение BS_ROOT (если ещё не задан)
if [[ -z "${BS_ROOT:-}" ]]; then
  # Если bs запущен из репо-корня, bootstrap/init.sh рядом
  if [[ -f "${BS_DIR}/bootstrap/init.sh" ]]; then
    BS_ROOT=$BS_DIR
  else
    # Ищем в стандартных местах
    for dir in "${HOME}/.local/lib/bs" "${BS_SYSTEM_PREFIX:-/usr/local}/lib/bs"; do
      if [[ -f "${dir}/bootstrap/init.sh" ]]; then
        BS_ROOT=$dir
        break
      fi
    done
  fi
  export BS_ROOT
fi

# 4. BS_HOME и тишина по умолчанию / BS_HOME and quiet-by-default
# BS_HOME: историческое расхождение с BS_ROOT в lib-модулях;
# задаём единообразно, чтобы скриптам не приходилось экспортировать его руками
# BS_HOME: historical mismatch with BS_ROOT in lib modules;
# set it uniformly so scripts do not have to export it by hand
: "${BS_HOME:=${BS_ROOT}}"
export BS_HOME

# По умолчанию не шумим при загрузке ядра: вывод скрипта важнее
# Quiet by default when loading core: the script's own output matters more
: "${BS_SILENT:=1}"
export BS_SILENT

# 5. Загрузка ядра
if [[ ! -f "${BS_ROOT}/bootstrap/init.sh" ]]; then
  printf 'ERROR: bootstrap/init.sh not found in BS_ROOT=%s\n' "$BS_ROOT" >&2
  exit 2
fi
# CLI всегда загружает ядро заново, даже если окружение уже
# инициализировано (BS_INITIALIZED из sourced-сессии иначе пропустит загрузку)
unset BS_INITIALIZED
source "${BS_ROOT}/bootstrap/init.sh"

# EXIT-trap для стека cleanup (ядро при source trap больше не ставит)
# EXIT trap for the cleanup stack (core no longer sets it when sourced)
errorhandler::setup_trap


# ==========================================
# bs build: standalone self-extracting script / сборка в один файл
# ==========================================


# ==========================================
# bs api: OpenAPI 3.x client (spec load, introspect, call)
# bs api: OpenAPI 3.x клиент (загрузка схемы, интроспекция, вызовы)
# ==========================================


# ==========================================
# bs audit: GNU-only tool usage in core/ and lib/
# bs audit: использование GNU-only инструментов в core/ и lib/
# ==========================================


# ==========================================
# bs update: apply repo changes (local checkout or GitHub) to installed copies
# bs update: применить изменения репозитория (локального или с GitHub) к установленным копиям
# ==========================================


# ---------- Что запущено сейчас / what is running now ----------


UPDATE_RUN_INFO=""
UPDATE_RUN_BLOCK=""
UPDATE_RUN_SHORT=""


# ---------- Блокировка, откат, чистка / lock, rollback, cleanup ----------


# ==========================================
# bs uninstall: remove installed BS copies / удаление установленных копий
# ==========================================


# ==========================================
# bs where: следы BS в системе (только чтение, ничего не запускается)
# bs where: traces of BS on this system (read-only, nothing is executed)
# ==========================================


# 6b. Глобальный флаг --strict-shell: tier модулей lib/ против оболочки запуска
# Global flag --strict-shell: lib/ module tiers against the shell BS was started from
: "${BS_ORIGIN_SHELL:=bash}"
export BS_ORIGIN_SHELL
if [[ "${1:-}" == "--strict-shell" ]]; then
  export BS_SHELL_STRICT=1
  shift
fi

# 7. Shebang-режим
# Если bs вызван как интерпретатор shebang'а (#!/usr/bin/env bs),
# первый аргумент — путь к существующему скрипту, а не команда.
if [[ $# -ge 1 && -f "$1" ]]; then
  case "$1" in
    help|-h|--help|version|env|list|lang-doc|lsp|chat|sync|rfc|api|ts|audit|doctor|run|build|repl|calc|init-shell|update|uninstall|where) : ;;
    *) BS_SHEBANG=1 ;;
  esac
fi
if [[ "${BS_SHEBANG:-0}" == "1" ]]; then
  [[ $# -ge 1 ]] || bs::cli::die "shebang mode: script path required"
  bs::cli::run_cmd "$@"
  # Функция bs::cli::run_cmd сама сделает exec, поэтому дальше не продолжаем.
fi

# 8. Обычный CLI-диспетчер
case "${1:-help}" in
  help|-h|--help)
    shift || true
    if [[ $# -ge 1 ]]; then
      bs::cli::help_cmd "$1"
    else
      bs::cli::help
    fi
    ;;
  version)        shift; bs::cli::version_cmd "$@" ;;
  env)            bs::cli::env_cmd ;;
  list)           bs::cli::list_cmd ;;
  lang-doc)       shift; bs::cli::lang_doc_cmd "$@" ;;
  lsp)            shift; bs::cli::lsp_cmd "$@" ;;
  chat)           shift; bs::cli::chat_cmd "$@" ;;
  update)         shift; bs::cli::update_cmd "$@" ;;
  uninstall)      shift; bs::cli::uninstall_cmd "$@" ;;
  where)          shift; bs::cli::where_cmd "$@" ;;
  sync)           shift; log::warn "sync is deprecated — use: bs update" && bs::cli::update_cmd "$@" ;;
  rfc)            shift; bs::cli::rfc_cmd "$@" ;;
  api)            shift; bs::cli::api_cmd "$@" ;;
  ts)             shift; bs::cli::ts_cmd "$@" ;;
  audit)          shift; bs::cli::audit_cmd "$@" ;;
  doctor)         shift || true; bs::cli::doctor_cmd "$@" ;;
  run)            shift; bs::cli::run_cmd "$@" ;;
  build)          shift; bs::cli::build_cmd "$@" ;;
  repl)           shift
                  if ! source -- "${BS_ROOT}/core/repl.sh"; then
                    bs::cli::die "repl: core/repl.sh not found"
                  fi
                  repl::main "$@" ;;
  calc)           shift
                  if ! source -- "${BS_ROOT}/core/calc.sh"; then
                    bs::cli::die "calc: core/calc.sh not found"
                  fi
                  calc::main "$@" ;;
  init-shell)     shift; bs::cli::init_shell_cmd "$@" ;;
  *)              bs::cli::die "unknown command: $1" ;;
esac
