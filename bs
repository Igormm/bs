#!/usr/bin/env bash
# 
#  BS Framework – STAGE-2 UNIFIED ENTRY-POINT / INTERPRETER
#  Назначение / Purpose:
#    - инициализировать окружение фреймворка;
#    - обрабатывать пользовательские команды (run, doctor, list …);
#    - работать как shebang-интерпретатор (#!/usr/bin/env bs).
#  Зависимости: bash 4.0+, bootstrap/init.sh, структура каталогов
#              core/, lib/ (опционально, но doctor ругается).
# 

# strict
set -euo pipefail
IFS=$'\n\t'

# Ensure running under Bash 4+
if [[ -z "${BASH_VERSION:-}" || ${BASH_VERSINFO[0]} -lt 4 ]]; then
  printf 'ERROR: bash 4.0+ required\n' >&2
  exit 1
fi

# 1. Версия фреймворка 
readonly BS_VERSION='0.4.0'

# 3. Определение BS_ROOT (если ещё не задан) 
if [[ -z "${BS_ROOT:-}" ]]; then
  # Если bs запущен из репо-корня, bootstrap/init.sh рядом
  BS_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
  if [[ -f "${BS_DIR}/bootstrap/init.sh" ]]; then
    BS_ROOT=$BS_DIR
  else
    # Ищем в стандартных местах
    for dir in "${HOME}/.local/lib/bs" "/usr/local/lib/bs"; do
      if [[ -f "${dir}/bootstrap/init.sh" ]]; then
        BS_ROOT=$dir
        break
      fi
    done
  fi
  export BS_ROOT
fi

# BS_HOME: историческое расхождение с BS_ROOT в lib-модулях;
# задаём единообразно, чтобы скриптам не приходилось экспортировать его руками
# BS_HOME: historical mismatch with BS_ROOT in lib modules;
# set it uniformly so scripts do not have to export it by hand
: "${BS_HOME:=${BS_ROOT}}"
export BS_HOME

# По умолчанию не шумим при загрузке ядра: вывод скрипта важнее
# Quiet by default when loading core: the script's own output matters more
: "${BS_SILENT:=1}"
export BS_SILENT

# 4. Загрузка ядра 
if [[ ! -f "${BS_ROOT}/bootstrap/init.sh" ]]; then
  printf 'ERROR: bootstrap/init.sh not found in BS_ROOT=%s\n' "$BS_ROOT" >&2
  exit 2
fi
# CLI всегда загружает ядро заново, даже если окружение уже
# инициализировано (BS_INITIALIZED из sourced-сессии иначе пропустит загрузку)
unset BS_INITIALIZED
source "${BS_ROOT}/bootstrap/init.sh"

# EXIT-trap для стека cleanup (ядро при source trap больше не ставит)
# EXIT trap for the cleanup stack (core no longer sets it when sourced)
errorhandler::setup_trap

# 5. Утилитные функции 
die()  { error::exit "$*"; }


help() {
  cat <<HELP
BS Framework ${BS_VERSION} – command launcher & shebang interpreter
Usage: bs [command] [args...]

Commands:
  help, -h, --help      Show this help
  version               Print framework version
  env                   Show environment (BS_ROOT, PATH)
  list                  List available modules (core/, lib/)
  lang-doc              Emit a JSON index of function docs (LSP metadata)
  lsp                   Run the language server (stdin/stdout, JSON-RPC)
  chat                  Interactive LLM chat (openai/ollama, --url for custom)
  doctor                Check framework integrity
  run <script> [args]   Execute script inside BS environment
  build <script>        Assemble a standalone self-extracting script
  repl                   Interactive REPL (BS shell / интерактивная консоль)
  update                   Apply repo changes to installed copies (no reinstall)
  init-shell             Print snippet for ~/.bashrc or ~/.zshrc

Shebang mode:
  #!/usr/bin/env bs
  (set BS_SHEBANG=1 internally)

Examples:
  bs doctor
  bs run ./examples/deploy.sh --prod
  bs list | grep system
HELP
}

version() { printf 'BS Framework version: %s\n' "$BS_VERSION"; }
env_cmd() { printf 'BS_ROOT=%s\nPATH=%s\n' "$BS_ROOT" "$PATH"; }

list_cmd() {
  echo 'Available modules:'
  local file
  while IFS= read -r file; do
    is::file "${file}" && printf '  %s\n' "${file#"${BS_ROOT}"/}"
  done < <(find "${BS_ROOT}/core" "${BS_ROOT}/lib" -type f -name '*.sh' 2>/dev/null | sort)
}

lang_doc_cmd() {
  local file=""
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --file)
        shift
        [[ $# -ge 1 ]] || die "lang-doc: --file requires a path"
        file="$1"
        shift ;;
      -h|--help)
        printf 'Usage: bs lang-doc [--file path]\n\n'
        printf 'Emits a JSON array of {name, file, description, params, returns,\n'
        printf 'stdout, example, deprecated} for every documented function in\n'
        printf 'core/ and lib/. With --file, only that file is parsed.\n'
        printf 'Requires jq (optional dev dependency).\n'
        return 0 ;;
      *)
        die "lang-doc: unknown argument: $1" ;;
    esac
  done

  load "lib/data/langdoc"
  is::command jq || die "lang-doc: jq is required (optional dev tool)"

  if is::not_empty "${file}"; then
    is::file "${file}" || die "lang-doc: file not found: ${file}"
    langdoc::parse_file "${file}" | jq -s -c .
  else
    langdoc::index "${BS_ROOT}"
  fi
}

lsp_cmd() {
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      -h|--help)
        printf 'Usage: bs lsp\n\n'
        printf 'Runs a minimal Language Server (JSON-RPC 2.0 over stdin/stdout,\n'
        printf 'Content-Length framing): initialize, hover, completion,\n'
        printf 'full text sync. The function index over BS_ROOT is built lazily.\n'
        printf 'Requires jq. Wire it up in VS Code / Neovim as a custom server.\n'
        return 0 ;;
      *)
        die "lsp: unknown argument: $1" ;;
    esac
  done

  load "lib/data/langdoc"
  load "lib/data/lsp"
  is::command jq || die "lsp: jq is required (optional dev tool)"
  lsp::server
}

chat_cmd() {
  local provider="${BS_CHAT_PROVIDER:-}"
  local model="${BS_CHAT_MODEL:-}"
  local system_prompt="${BS_CHAT_SYSTEM:-You are a helpful assistant for the BS framework.}"
  local one_shot="" limit=20 show_raw=0 url="" api_key=""
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --provider)
        shift
        [[ $# -ge 1 ]] || die "chat: --provider requires a name"
        provider="$1"
        shift ;;
      --model|-m)
        shift
        [[ $# -ge 1 ]] || die "chat: --model requires a name"
        model="$1"
        shift ;;
      --system|-s)
        shift
        [[ $# -ge 1 ]] || die "chat: --system requires a prompt"
        system_prompt="$1"
        shift ;;
      --one-shot)
        shift
        [[ $# -ge 1 ]] || die "chat: --one-shot requires a message"
        one_shot="$1"
        shift ;;
      --history)
        shift
        [[ $# -ge 1 ]] || die "chat: --history requires a number"
        limit="$1"
        shift ;;
      --url)
        shift
        [[ $# -ge 1 ]] || die "chat: --url requires an endpoint (e.g. http://pi.local:8080/v1/chat/completions)"
        url="$1"
        shift ;;
      --api-key)
        shift
        [[ $# -ge 1 ]] || die "chat: --api-key requires a key"
        api_key="$1"
        shift ;;
      --show-raw)
        show_raw=1
        shift ;;
      -h|--help)
        printf 'Usage: bs chat [--provider p] [--model m] [--system text]\n'
        printf '          [--one-shot msg] [--history N] [--url URL] [--api-key KEY]\n\n'
        printf 'Interactive multi-turn chat with an LLM.\n'
        printf 'Providers: openai (API key required) or ollama (local).\n'
        printf 'A custom local model (e.g. Phi Pi) plugs in as an OpenAI-compatible\n'
        printf 'endpoint: bs chat --url http://host:port/v1/chat/completions --model phi-pi\n'
        printf 'Env defaults: BS_CHAT_PROVIDER, BS_CHAT_MODEL, BS_CHAT_SYSTEM.\n'
        printf 'Requires curl and jq.\n'
        return 0 ;;
      *)
        if is::empty "${one_shot}"; then
          one_shot="$1"
        else
          die "chat: unexpected argument: $1"
        fi
        shift ;;
    esac
  done

  load "lib/integration/llm"
  load "lib/integration/chat"
  is::command curl || die "chat: curl is required"
  is::command jq || die "chat: jq is required"

  # Дефолтный провайдер: ollama, если доступен, иначе openai
  # Default provider: ollama when reachable, otherwise openai
  if is::empty "${provider}"; then
    if llm::is_available ollama; then
      provider="ollama"
    else
      provider="openai"
    fi
  fi
  if is::empty "${model}"; then
    if [[ "${provider}" == "ollama" ]]; then
      model="${LLM_OLLAMA_MODEL:-llama3}"
    else
      model="${LLM_OPENAI_MODEL:-gpt-3.5-turbo}"
    fi
  fi

  # Переопределение эндпоинта / Endpoint override
  if is::not_empty "${url}"; then
    if [[ "${provider}" == "ollama" ]]; then
      export LLM_OLLAMA_HOST="${url}"
    else
      export LLM_OPENAI_URL="${url}"
    fi
  fi
  if is::not_empty "${api_key}"; then
    export OPENAI_API_KEY="${api_key}"
  fi

  chat::repl "${provider}" "${model}" "${system_prompt}" "${one_shot}" "${limit}" "${show_raw}"
}

doctor_cmd() {
  local fail=0
  echo "BS doctor report"
  echo "BS_ROOT: $BS_ROOT"

  # Bash version / Версия bash
  echo "Bash version: ${BASH_VERSION}"
  if [[ ${BASH_VERSINFO[0]} -ge 4 ]]; then
    echo "  [OK] Bash version"
  else
    echo "  [FAIL] Bash 4.0+ required"; fail=1
  fi

  # Required core files / Обязательные файлы ядра
  local req=(bootstrap/init.sh bootstrap/loader.sh core/prereq.sh core/lang.sh core/const.sh core/logger.sh core/errorhandler.sh core/version.sh core/utils.sh core/config.sh core/deps.sh core/repl.sh)
  for f in "${req[@]}"; do
    if is::file "${BS_ROOT}/${f}"; then
      echo "  [OK] ${f}"
    else
      echo "  [FAIL] ${f}"; fail=1
    fi
  done

  # Required directories / Обязательные директории
  for d in core lib; do
    if is::dir "${BS_ROOT}/${d}"; then
      echo "  [OK] dir ${d}"
    else
      echo "  [FAIL] dir ${d}"; fail=1
    fi
  done

  # Optional external tools / Опциональные внешние инструменты
  local opt
  for opt in shellcheck jq curl wget kubectl; do
    if is::command "${opt}"; then
      echo "  [OK] optional tool: ${opt}"
    else
      echo "  [OPTIONAL] missing tool: ${opt}"
    fi
  done

  # Optional dependency check for lib modules / Проверка опциональных зависимостей lib-модулей
  if is::function deps::check_module; then
    echo "Module dependency check:"
    local module
    for module in lib/integration/result lib/integration/http lib/integration/llm lib/integration/k8s; do
      if is::file "${BS_ROOT}/${module}.sh"; then
        if utils::quiet deps::check_module "${module}"; then
          echo "  [OK] ${module}: dependencies satisfied"
        else
          local missing
          missing="$(utils::attempt deps::list_missing "${module}")"
          echo "  [OPTIONAL] ${module}: missing dependencies: ${missing}"
        fi
      fi
    done
  fi

  return "$fail"
}

run_cmd() {
  [[ $# -eq 0 ]] && die "run: script path required"
  local script=$1; shift
  is::file "$script" || die "run: file not found: $script"
  # Запускаем скрипт в новом bash с уже загруженным BS-окружением
  # Сбрасываем унаследованный BS_INITIALIZED, иначе init.sh пропустит загрузку
  exec bash -c '
    set -euo pipefail
    unset BS_INITIALIZED
    source "'"${BS_ROOT}/bootstrap/init.sh"'"
    script=$1; shift
    source "$script" "$@"
  ' bash "$script" "$@"
}

# ==========================================
# bs build: standalone self-extracting script / сборка в один файл
# ==========================================

# Build helper: base64 with -w0 fallback for busybox / base64 с fallback на busybox
bs_build::b64() {
  if printf '' | base64 -w0 >/dev/null 2>&1; then
    base64 -w0
  else
    base64 | tr -d '\n'
  fi
}

# Build helper: robust sha256 (coreutils, busybox-less systems, macOS) / sha256 с fallback
bs_build::sha256() {
  if utils::has sha256sum; then
    sha256sum | awk '{print $1}'
  elif utils::has shasum; then
    shasum -a 256 | awk '{print $1}'
  else
    cksum | awk '{print $1}'
  fi
}

# Runtime preamble of the generated standalone file.
# Не зависит от фреймворка: распаковывает себя в кэш и запускает bs.
# Framework-independent: extracts itself into a cache dir and execs bs.
bs_build::preamble() {
  cat <<'PREAMBLE'
#!/usr/bin/env bash
# BS standalone application — generated by `bs build` / собрано командой `bs build`.
# Self-extracting: unpacks the bundled framework into a cache dir, then execs bs.
set -euo pipefail

bs_seek::b64() {
  if printf '' | base64 -w0 >/dev/null 2>&1; then
    base64 -w0
  else
    base64 | tr -d '\n'
  fi
}

bs_seek::sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | awk '{print $1}'
  else
    cksum | awk '{print $1}'
  fi
}

bs_seek::main() {
local line payload
  line="$(grep -n '^#__BS_BUILD_PAYLOAD__' "$0" | head -n 1 | cut -d: -f1 || true)"
  [[ -n "${line}" ]] || { echo "bs: payload marker not found in $0" >&2; exit 1; }
  payload="$(sed -n "$((line + 1)),\$p" "$0")"
  [[ -n "${payload}" ]] || { echo "bs: empty payload in $0" >&2; exit 1; }

  local hash cache_root root tmp
  hash="$(printf '%s' "${payload}" | bs_seek::sha256)"
  cache_root="${BS_BUILD_CACHE_DIR:-${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/bs}"
  root="${cache_root}/${hash}"

  if [[ ! -x "${root}/bs" ]]; then
    mkdir -p "${cache_root}"
    tmp="$(mktemp -d "${cache_root}/extract.XXXXXX")"
    printf '%s' "${payload}" | base64 -d | tar -xz -C "${tmp}"
    mv "${tmp}" "${root}" 2>/dev/null || rm -rf "${tmp}"
  fi

  export BS_ROOT="${root}"
  export BS_HOME="${root}"
  export BS_SILENT=1
  export BS_CACHE_DIR="${root}"
  exec "${root}/bs" run "${root}/app/main.sh" "$@"
}

bs_seek::main "$@"
PREAMBLE
}

# Assemble a standalone self-extracting script / Собрать standalone-скрипт
# @usage bs build <script.sh> [--output file]
build_cmd() {
  local script="" out_file=""
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      -h|--help)
        printf 'Usage: bs build <script.sh> [--output file]\n\n'
        printf 'Assembles a standalone self-extracting script: framework and\n'
        printf 'the app are bundled (gzip+base64) and extracted to a cache dir\n'
        printf 'at first run. Cache: $XDG_CACHE_HOME/bs or BS_BUILD_CACHE_DIR.\n'
        return 0 ;;
      --output)
        shift
        [[ $# -ge 1 ]] || die "build: --output requires a path"
        out_file="$1"; shift ;;
      *)
        if is::empty "${script}"; then
          script="$1"
        else
          die "build: unexpected extra argument: $1"
        fi
        shift ;;
    esac
  done

  is::not_empty "${script}" || die "build: script path required"
  is::file "$script" || die "build: file not found: $script"
  if ! utils::quiet_err bash -n "$script"; then
    die "build: bash syntax errors in: $script"
  fi

  [[ -n "$out_file" ]] || out_file="${script%.sh}.standalone.sh"

  local tmp_dir app_dir
  tmp_dir="$(mktemp -d)"
  trap 'rm -rf "${tmp_dir}"' RETURN

  # Спрятать app под app/main.sh внутри payload
  # The app is bundled as app/main.sh inside the payload
  app_dir="${tmp_dir}/app"
  mkdir -p "${app_dir}"
  utils::quiet cp -- "$script" "${app_dir}/main.sh" || die "build: cannot read script: $script"

  # Бандл: рантайм-дерево (bootstrap core lib bs) + app/ одним tar-потоком.
  # Конкатенация двух tar-архивов читается далеко не всеми tar'ами,
  # поэтому используем один вызов с двумя -C.
  # Bundle: runtime tree (bootstrap core lib bs) + app/ in one tar stream.
  # Two concatenated tar archives are not readable by every tar,
  # so use a single invocation with two -C.
  # base64 до bash-переменной: gzip содержит NUL-байты, которые
  # command substitution молча вырезает.
  # Base64 before the bash variable: gzip contains NULs which
  # command substitution silently strips.
  local payload hash
  payload="$(
    tar -C "${BS_ROOT}" -c -f - bootstrap core lib bs \
        -C "${tmp_dir}" app \
    | gzip | bs_build::b64
  )"
  hash="$(printf '%s' "${payload}" | bs_build::sha256)"

  # Output written under a temp name, then moved — атомарность и права
  local out_tmp
  out_tmp="${out_file}.bs-build.$$"
  bs_build::preamble > "${out_tmp}"
  printf '%s\n' "#__BS_BUILD_PAYLOAD__" >> "${out_tmp}"
  printf '%s\n' "${payload}" >> "${out_tmp}"
  chmod 0755 "${out_tmp}"
  mv -f -- "${out_tmp}" "${out_file}"
  rm -rf "${tmp_dir}"

  printf 'Built: %s\n' "${out_file}"
  printf 'Framework bundle: %s bytes (payload hash %s)\n' "$(( ${#payload} ))" "${hash}"
}

init_shell_cmd() {
  cat <<EOF
# Add to ~/.bashrc or ~/.zshrc
export BS_ROOT="${BS_ROOT}"
source "\${BS_ROOT}/bootstrap/init.sh"
EOF
}

# ==========================================
# bs update: apply repo changes to installed copies without reinstalling
# bs update: применить изменения репозитория к установленным копиям
# ==========================================

update_cmd() {
  local from="${BS_ROOT}"
  local -a targets=()
  local explicit=0
  local verbose=0

  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --local)
        explicit=1
        targets+=("${HOME}/.local/lib/bs")
        shift ;;
      --system)
        explicit=1
        targets+=("/usr/local/lib/bs")
        shift ;;
      --lib)
        shift
        [[ $# -ge 1 ]] || die "update: --lib requires a target directory"
        explicit=1
        targets+=("$1")
        shift ;;
      --from)
        shift
        [[ $# -ge 1 ]] || die "update: --from requires a source directory"
        from="$1"
        shift ;;
      -v|--verbose)
        verbose=1
        shift ;;
      -h|--help)
        printf 'Usage: bs update [--local] [--system] [--lib DIR] [--from DIR] [-v]\n\n'
        printf 'Copies framework changes from the source repository to installed\n'
        printf 'copies without reinstalling. Run from the repo: ./bs update\n'
        printf '  --local   update to ~/.local/lib/bs      (local install)\n'
        printf '  --system  update to /usr/local/lib/bs    (system install, needs root)\n'
        printf '  --lib DIR update to a custom install directory\n'
        printf '  --from    source repo (default: running BS_ROOT)\n'
        printf 'Without flags: update to every detected install (local + system).\n'
        printf 'Copies bootstrap/, core/, lib/, bs. Use sudo bs update --system.\n'
        return 0 ;;
      *)
        die "update: unknown argument: $1" ;;
    esac
  done

  # Детект установок / Detect installs
  if (( explicit == 0 )); then
    if is::dir "${HOME}/.local/lib/bs"; then
      targets+=("${HOME}/.local/lib/bs")
    fi
    if is::dir "/usr/local/lib/bs"; then
      targets+=("/usr/local/lib/bs")
    fi
  fi

  if (( ${#targets[@]} == 0 )); then
    die "update: no BS installs found (use --local, --system or --lib DIR)"
  fi
  is::dir "${from}/core" || die "update: source is not a BS repo: ${from}"

  local target item ok=0
  for target in "${targets[@]}"; do
    if ! is::dir "${target}"; then
      log::warn "update: target not found, skipping: ${target}"
      continue
    fi
    if ! [[ -w "${target}" ]]; then
      log::warn "update: target not writable: ${target} (try: sudo bs update --system)"
      continue
    fi
    log::info "syncing ${from} -> ${target}"
    cp -a "${from}/bootstrap" "${from}/core" "${from}/lib" "${from}/bs" "${target}/"
    ok=1
    if (( verbose == 1 )); then
      log::info "  files: $(find "${from}/core" "${from}/lib" -name '*.sh' | wc -l) modules copied"
    fi
  done

  (( ok == 1 )) || die "update: nothing to update"
  log::success "sync done — changes are live without reinstalling"
}

# 6. Shebang-режим 
# Если bs вызван как интерпретатор shebang'а (#!/usr/bin/env bs),
# первый аргумент — путь к существующему скрипту, а не команда.
if [[ $# -ge 1 && -f "$1" ]]; then
  case "$1" in
    help|-h|--help|version|env|list|lang-doc|lsp|chat|sync|doctor|run|build|repl|init-shell) : ;;
    *) BS_SHEBANG=1 ;;
  esac
fi
if [[ "${BS_SHEBANG:-0}" == "1" ]]; then
  [[ $# -ge 1 ]] || die "shebang mode: script path required"
  run_cmd "$@"
  # Функция run_cmd сама сделает exec, поэтому дальше не продолжаем.
fi

# 7. Обычный CLI-диспетчер 
case "${1:-help}" in
  help|-h|--help) help ;;
  version)        version ;;
  env)            env_cmd ;;
  list)           list_cmd ;;
  lang-doc)       shift; lang_doc_cmd "$@" ;;
  lsp)            shift; lsp_cmd "$@" ;;
  chat)           shift; chat_cmd "$@" ;;
  update)           shift; update_cmd "$@" ;;
  doctor)         doctor_cmd ;;
  run)            shift; run_cmd "$@" ;;
  build)          shift; build_cmd "$@" ;;
  repl)           shift
                  if ! source -- "${BS_ROOT}/core/repl.sh"; then
                    die "repl: core/repl.sh not found"
                  fi
                  repl::main "$@" ;;
  init-shell)     init_shell_cmd ;;
  *)              die "unknown command: $1" ;;
esac