#!/usr/bin/env bash
# BS Framework - Enhanced Bash Scripting
# Фреймворк BS - Расширенное bash-скриптование
#
# НАЗНАЧЕНИЕ: Главный entrypoint фреймворка BS
# PURPOSE: Main entrypoint for BS framework
#
# ЗАВИСИМОСТИ: bash 4.0+, стандартные утилиты Linux
# DEPENDENCIES: bash 4.0+, standard Linux utilities
#
# ИСПОЛЬЗУЕТСЯ: Для инициализации фреймворка и загрузки модулей
# USAGE: For framework initialization and module loading
#
# bs — интерпретатор для shebang: #!/usr/bin/env bs
# interpreter for shebang: #!/usr/bin/env bs

set -euo pipefail

if [[ -z "${BASH_VERSION:-}" ]]; then
  printf "ERROR: BS requires bash.\n" >&2
  printf "ОШИБКА: BS требует bash.\n" >&2
  exit 1
fi

# Resolve BS_ROOT / Определяем BS_ROOT
if [[ -z "${BS_ROOT:-}" ]]; then
  # Try to determine the root location
  BS_ROOT="$(bs_resolve_root)"
  if [[ -n "${BS_ROOT}" ]]; then
    export BS_ROOT
  else
    printf "ERROR: Could not determine BS_ROOT\n" >&2
    printf "ОШИБКА: Не удалось определить BS_ROOT\n" >&2
    exit 1
  fi
fi

if [[ ! -d "${BS_ROOT}" ]]; then
  printf "ERROR: Invalid BS_ROOT: %s\n" "${BS_ROOT}" >&2
  printf "ОШИБКА: Некорректный BS_ROOT: %s\n" "${BS_ROOT}" >&2
  exit 1
fi

# Bootstrap initialization
bootstrap_init="${BS_ROOT}/bootstrap/init.sh"
if [[ -f "${bootstrap_init}" ]]; then
  # shellcheck disable=SC1090
  source "${bootstrap_init}"
fi

# Function to resolve the BS root directory
bs_resolve_root() {
  local bin_dir
  bin_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

  # 1. Check: local run from repository
  if [[ -f "${bin_dir}/../bs" ]] && [[ -d "${bin_dir}/../bootstrap" ]]; then
    echo "$(cd -- "${bin_dir}/.." && pwd)"
    return 0
  fi

  # 2. Check: system installation (/usr/local/lib/bs)
  if [[ -d "/usr/local/lib/bs" ]] && [[ -f "/usr/local/lib/bs/bootstrap/init.sh" ]]; then
    echo "/usr/local/lib/bs"
    return 0
  fi

  # 3. Check: local installation (~/.local/lib/bs)
  local local_path="${HOME}/.local/lib/bs"
  if [[ -d "${local_path}" ]] && [[ -f "${local_path}/bootstrap/init.sh" ]]; then
    echo "${local_path}"
    return 0
  fi

  # Fallback for compatibility
  echo "/usr/local/lib/bs"
  return 1
}

VERSION="0.1.0"

usage() {
  cat <<'HELP'
BS - command launcher

Usage:
  bs [command] [args...]

Common commands / Частые команды:
  help                 - show help / показать помощь
  version              - show version / показать версию
  env                  - print environment info / информация окружения
  init-shell           - source bootstrap for current shell / инициализация окружения
  run <script> [args]  - run script within BS env / запуск скрипта в окружении BS

HELP
}

# CLI handling
case "${1:-}" in
  -h | --help | help)
    usage
    ;;
    
  -v | --version | version)
    printf "BS version: %s\n" "${VERSION}"
    printf "Версия BS: %s\n" "${VERSION}"
    ;;
    
  env)
    printf "BS_ROOT=%s\n" "${BS_ROOT}"
    printf "PATH=%s\n" "${PATH}"
    ;;
    
  init-shell)
    if [[ -f "${bootstrap_init}" ]]; then
      # shellcheck disable=SC1090
      source "${bootstrap_init}"
      printf "Bootstrap sourced. Opened in current shell.\n"
      printf "Бутстрап подключён. Окружение обновлено для текущей оболочки.\n"
    else
      printf "ERROR: bootstrap/init.sh not found in %s\n" "${BS_ROOT}" >&2
      printf "ОШИБКА: bootstrap/init.sh не найден в %s\n" "${BS_ROOT}" >&2
      exit 1
    fi
    ;;
    
  --where)
    echo "${BS_ROOT}"
    ;;
    
  doctor)
    bs_doctor
    ;;
    
  list)
    bs_list_modules
    ;;
    
  run)
    script_path="${2:-}"
    if [[ -z "${script_path}" ]]; then
      printf "ERROR: 'run' requires a script path.\n" >&2
      printf "ОШИБКА: 'run' требует путь к скрипту.\n" >&2
      exit 1
    fi
    shift 2 || true
    if [[ ! -f "${script_path}" ]]; then
      printf "ERROR: Script not found: %s\n" "${script_path}" >&2
      printf "ОШИБКА: Скрипт не найден: %s\n" "${script_path}" >&2
      exit 1
    fi
    exec /usr/bin/env bash "${script_path}" "$@"
    ;;
    
  *)
    # Dispatch to core subcommands if available
    if [[ -x "${BS_ROOT}/core/${1:-}.sh" ]]; then
      exec "${BS_ROOT}/core/$1.sh" "${@:2}"
    else
      # If no specific command found, treat as shebang mode
      bs_shebang_mode "$@"
    fi
    ;;
esac

# Function for diagnostic checks
bs_doctor() {
  echo "bs Doctor Report"
  echo "BS_ROOT: ${BS_ROOT}"
  
  # Check core files
  check_file_exists "${BS_ROOT}/bs" "entrypoint bs"
  check_file_exists "${BS_ROOT}/bootstrap/init.sh" "bootstrap/init.sh"
  check_file_exists "${BS_ROOT}/core/logger.sh" "core/logger.sh"
  
  # Check system dependencies
  if command -v bash >/dev/null 2>&1; then
    echo "[OK] bash (version: $(bash --version | head -n1))"
  else
    echo "[ERROR] bash"
  fi
  
  # Check Bash version compatibility
  if [[ -n "${BASH_VERSION:-}" ]]; then
    local major_version="${BASH_VERSION%%.*}"
    if (( major_version >= 4 )); then
      echo "[OK] bash version ${BASH_VERSION} (>= 4.0)"
    else
      echo "[WARNING] bash version ${BASH_VERSION} (< 4.0)"
    fi
  else
    echo "[ERROR] could not determine bash version"
  fi

  # Check core modules
  check_file_exists "${BS_ROOT}/core/const.sh" "core/const.sh"
  
  if [[ -f "${BS_ROOT}/core/version.sh" ]]; then
    echo "[OK] core/version.sh"
    # Try to get version
    local version_content
    version_content=$(grep "^export BOSA_VERSION=" "${BS_ROOT}/core/version.sh" 2>/dev/null)
    if [[ -n "${version_content}" ]]; then
      local version
      version=$(echo "${version_content}" | cut -d'"' -f2)
      echo "  - Version: ${version}"
    fi
  else
    echo "[ERROR] core/version.sh"
  fi

  check_file_exists "${BS_ROOT}/core/errorhandler.sh" "core/error_handler.sh"
  
  # Check library modules
  if [[ -d "${BS_ROOT}/lib" ]]; then
    echo "[OK] lib directory exists"
    local module_count
    module_count=$(find "${BS_ROOT}/lib" -name "*.sh" -type f | wc -l)
    echo "  - Found ${module_count} library modules"
  else
    echo "[ERROR] lib directory missing"
  fi
  
  # Check system modules
  check_file_exists "${BS_ROOT}/lib/system/distro.sh" "system/distro.sh"
  check_file_exists "${BS_ROOT}/lib/system/utils.sh" "system/utils.sh"
  check_file_exists "${BS_ROOT}/lib/automation.sh" "automation.sh"
  
  # Check distribution detection
  if command -v lsb_release >/dev/null 2>&1; then
    echo "[OK] lsb_release available"
  elif [[ -f /etc/os-release ]]; then
    echo "[OK] /etc/os-release available"
  else
    echo "[WARNING] No distribution detection method available"
  fi
  
  # Check essential commands
  local essential_commands=("grep" "sed" "find" "ls" "cp" "mv" "rm")
  for cmd in "${essential_commands[@]}"; do
    if command -v "${cmd}" >/dev/null 2>&1; then
      echo "[OK] ${cmd}"
    else
      echo "[ERROR] ${cmd}"
    fi
  done
  
  # Check if system can load bs
  if [[ -n "${BS_INITIALIZED:-}" ]]; then
    echo "[INFO] bs already initialized in this session"
  else
    echo "[INFO] bs not initialized in this session"
    echo "  (This is normal when running from command line)"
  fi
}

# Helper function to check if a file exists
check_file_exists() {
  local file_path="$1"
  local description="$2"
  
  if [[ -f "${file_path}" ]]; then
    echo "[OK] ${description}"
  else
    echo "[ERROR] ${description}"
  fi
}

# Function to list available modules
bs_list_modules() {
  echo "Available bs modules:"
  echo ""
  
  # Find core modules
  if [[ -d "${BS_ROOT}/core" ]]; then
    echo "Core modules:"
    for module in "${BS_ROOT}"/core/*.sh; do
      if [[ -f "${module}" ]]; then
        echo "  core/$(basename "${module}" .sh)"
      fi
    done
    echo ""
  fi
  
  # Find library modules (including subdirectories)
  if [[ -d "${BS_ROOT}/lib" ]]; then
    echo "Library modules:"
    local rel_path
    while IFS= read -r -d '' module; do
      # Get relative path from BS_ROOT/lib
      rel_path="${module#${BS_ROOT}/lib/}"
      # Remove .sh extension
      rel_path="${rel_path%.sh}"
      echo "  lib/${rel_path}"
    done < <(find "${BS_ROOT}/lib" -type f -name "*.sh" -print0 2>/dev/null || true)
  fi
}

# Function to handle shebang mode execution
bs_shebang_mode() {
  local script_path="${1:-}"
  
  if [[ -z "${script_path}" ]]; then
    echo "bs: script path not specified (shebang mode)" >&2
    echo "bs: не указан путь к скрипту (shebang mode)" >&2
    exit 2
  fi
  
  if [[ ! -f "${script_path}" ]]; then
    echo "bs: script not found: ${script_path}" >&2
    echo "bs: скрипт не найден: ${script_path}" >&2
    exit 2
  fi
  
  # Execute the script with BS framework loaded
  exec bash -c '
    set -euo pipefail
    source "'"${BS_ROOT}/bootstrap/init.sh"'"
    source "'"$script_path"'"
  ' bash "$@"
}