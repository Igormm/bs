#!/usr/bin/env bash
# BS (Bash Scripting) Framework
# Unified entry point for the BS framework

set -euo pipefail

# Resolve the root directory of the BS framework
bs_resolve_root() {
    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    
    # If bootstrap/init.sh exists in the same directory as this script, 
    # we're running from the repository root
    if [[ -f "${script_dir}/bootstrap/init.sh" ]]; then
        echo "${script_dir}"
        return 0
    fi
    
    # Otherwise, look for the framework in standard locations
    local possible_paths=(
        "${HOME}/.local/lib/bs"
        "/usr/local/lib/bs"
    )
    
    for path in "${possible_paths[@]}"; do
        if [[ -d "${path}" && -f "${path}/bootstrap/init.sh" ]]; then
            echo "${path}"
            return 0
        fi
    done
    
    echo "Error: Could not find BS framework root" >&2
    exit 1
}

# Source the initialization script
bs_source_init() {
    local bs_root="$1"
    # shellcheck source=bootstrap/init.sh
    source "${bs_root}/bootstrap/init.sh"
}

# Check if a file exists
check_file_exists() {
    local file_path="$1"
    [[ -f "${file_path}" ]]
}

# Run in shebang mode
bs_shebang_mode() {
    local script_path="$1"
    shift
    
    local bs_root
    bs_root=$(bs_resolve_root)
    
    # Execute the script with proper argument passing
    exec bash -c '
        set -euo pipefail
        source "'"${bs_root}"'/bootstrap/init.sh"
        source "$1"
    ' bash "${script_path}" "${@}"
}

# List available modules
bs_list_modules() {
    local bs_root="$1"
    local module_dir
    local category
    local module_file
    
    for category in "core" "lib"; do
        module_dir="${bs_root}/${category}"
        
        if [[ ! -d "${module_dir}" ]]; then
            continue
        fi
        
        for module_file in "${module_dir}"/*.sh; do
            if [[ -f "${module_file}" ]]; then
                basename "${module_file}"
            fi
        done
    done
}

# Doctor command implementation
bs_doctor() {
    local bs_root="$1"
    local status=0
    
    echo "Checking BS framework integrity..."
    
    # Required files check
    local required_files=(
        "bootstrap/init.sh"
        "core/errorhandler.sh"
        "core/logger.sh"
        "lib/utils.sh"
    )
    
    for file in "${required_files[@]}"; do
        if [[ ! -f "${bs_root}/${file}" ]]; then
            echo "ERROR: Missing required file: ${file}"
            status=1
        else
            echo "OK: Found ${file}"
        fi
    done
    
    # Module directory check
    local module_dirs=("core" "lib")
    for dir in "${module_dirs[@]}"; do
        if [[ ! -d "${bs_root}/${dir}" ]]; then
            echo "ERROR: Missing directory: ${dir}"
            status=1
        else
            echo "OK: Found directory ${dir}"
        fi
    done
    
    # Check for common issues
    if ! command -v git >/dev/null 2>&1 && [[ -d "${bs_root}/.git" ]]; then
        echo "WARNING: Git not found, some features may be limited"
    fi
    
    return ${status}
}

# Main CLI handler
main() {
    local bs_root
    bs_root=$(bs_resolve_root)
    
    # Initialize the framework
    bs_source_init "${bs_root}"
    
    # Handle shebang mode
    if [[ "${BS_SHEBANG:-0}" == "1" ]]; then
        bs_shebang_mode "$@"
        return
    fi
    
    case "${1:-usage}" in
        help|--help|-h)
            echo "BS Framework - Unified Entry Point"
            echo "Usage:"
            echo "  bs [command]"
            echo ""
            echo "Commands:"
            echo "  help, --help, -h     Show this help message"
            echo "  version              Show framework version"
            echo "  env                  Show environment information"
            echo "  list                 List available modules"
            echo "  doctor               Check framework integrity"
            echo "  run <script>         Run a script with BS framework"
            echo "  init-shell           Generate shell initialization commands"
            ;;
            
        version)
            echo "BS Framework Version: ${BS_VERSION:-unknown}"
            ;;
            
        env)
            echo "BS_ROOT=${bs_root}"
            echo "BS_VERSION=${BS_VERSION:-unknown}"
            echo "BS_SHELL=${BS_SHELL:-$SHELL}"
            ;;
            
        list)
            bs_list_modules "${bs_root}"
            ;;
            
        doctor)
            bs_doctor "${bs_root}"
            ;;
            
        run)
            if [[ $# -lt 2 ]]; then
                echo "Error: No script provided for run command" >&2
                exit 1
            fi
            
            local script_to_run="$2"
            if [[ ! -f "${script_to_run}" ]]; then
                echo "Error: Script does not exist: ${script_to_run}" >&2
                exit 1
            fi
            
            # Run the script using the framework
            source "${script_to_run}"
            ;;
            
        init-shell)
            echo "# Add this to your ~/.bashrc or ~/.zshrc:"
            echo "export BS_ROOT=${bs_root}"
            echo 'source "${BS_ROOT}/bootstrap/init.sh"'
            ;;
            
        *)
            echo "Unknown command: $1. Use 'bs help' for usage information." >&2
            exit 1
            ;;
    esac
}

# Only execute main if not being sourced
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi